---
// Animated pixel logo: blinking crown, flickering B pixels, drifting glitch lines.
// Colors use theme variables so it adapts to light/dark mode automatically.
---

<svg
    class="logo-anim mx-auto block w-full max-w-md"
    viewBox="0 0 420 256"
    role="img"
    aria-label="Byte MVP pixel logo"
>
    <!-- B -->
    <g class="logo-ink">
        <rect x="32" y="56" width="16" height="16"/><rect x="48" y="56" width="16" height="16"/><rect x="64" y="56" width="16" height="16"/><rect x="80" y="56" width="16" height="16"/>
        <rect x="32" y="72" width="16" height="16"/><rect x="96" y="72" width="16" height="16"/>
        <rect x="32" y="88" width="16" height="16"/><rect x="96" y="88" width="16" height="16"/>
        <rect x="32" y="104" width="16" height="16"/><rect x="48" y="104" width="16" height="16"/><rect x="64" y="104" width="16" height="16"/><rect x="80" y="104" width="16" height="16"/>
        <rect x="32" y="120" width="16" height="16"/><rect x="96" y="120" width="16" height="16"/>
        <rect x="32" y="136" width="16" height="16"/><rect x="96" y="136" width="16" height="16"/>
        <rect x="32" y="152" width="16" height="16"/><rect x="48" y="152" width="16" height="16"/><rect x="64" y="152" width="16" height="16"/><rect x="80" y="152" width="16" height="16"/>
    </g>

    <!-- flickering pixels on the B (the "B is changing" effect) -->
    <g fill="#f5c518">
        <rect class="b-flicker" x="48" y="56" width="16" height="16" style="animation-delay: 0s"/>
        <rect class="b-flicker" x="96" y="88" width="16" height="16" style="animation-delay: 0.8s"/>
        <rect class="b-flicker" x="64" y="152" width="16" height="16" style="animation-delay: 1.6s"/>
    </g>

    <!-- shared vertical pixel line -->
    <g class="logo-ink">
        <rect x="112" y="56" width="16" height="16"/><rect x="112" y="72" width="16" height="16"/><rect x="112" y="88" width="16" height="16"/>
        <rect x="112" y="152" width="16" height="16"/>
    </g>
    <g class="logo-mut">
        <rect x="112" y="104" width="16" height="16"/><rect x="112" y="120" width="16" height="16"/><rect x="112" y="136" width="16" height="16"/>
    </g>

    <!-- MVP -->
    <g class="logo-mut">
        <rect x="128" y="72" width="16" height="16"/><rect x="176" y="72" width="16" height="16"/>
        <rect x="128" y="88" width="16" height="16"/><rect x="144" y="88" width="16" height="16"/><rect x="160" y="88" width="16" height="16"/><rect x="176" y="88" width="16" height="16"/>
        <rect x="128" y="104" width="16" height="16"/><rect x="152" y="104" width="16" height="16"/><rect x="176" y="104" width="16" height="16"/>
        <rect x="128" y="120" width="16" height="16"/><rect x="176" y="120" width="16" height="16"/>
        <rect x="128" y="136" width="16" height="16"/><rect x="176" y="136" width="16" height="16"/>

        <rect x="192" y="72" width="16" height="16"/><rect x="240" y="72" width="16" height="16"/>
        <rect x="192" y="88" width="16" height="16"/><rect x="240" y="88" width="16" height="16"/>
        <rect x="192" y="104" width="16" height="16"/><rect x="240" y="104" width="16" height="16"/>
        <rect x="208" y="120" width="16" height="16"/><rect x="224" y="120" width="16" height="16"/>
        <rect x="216" y="136" width="16" height="16"/>

        <rect x="256" y="72" width="16" height="16"/><rect x="272" y="72" width="16" height="16"/><rect x="288" y="72" width="16" height="16"/><rect x="304" y="72" width="16" height="16"/>
        <rect x="256" y="88" width="16" height="16"/><rect x="304" y="88" width="16" height="16"/>
        <rect x="256" y="104" width="16" height="16"/><rect x="272" y="104" width="16" height="16"/><rect x="288" y="104" width="16" height="16"/><rect x="304" y="104" width="16" height="16"/>
        <rect x="256" y="120" width="16" height="16"/>
        <rect x="256" y="136" width="16" height="16"/>
    </g>

    <!-- crown, blinking -->
    <g class="logo-crown" fill="#f5c518">
        <rect x="138" y="20" width="8" height="8"/><rect x="170" y="20" width="8" height="8"/>
        <rect x="138" y="28" width="8" height="8"/><rect x="146" y="28" width="8" height="8"/><rect x="154" y="28" width="8" height="8"/><rect x="162" y="28" width="8" height="8"/><rect x="170" y="28" width="8" height="8"/>
    </g>

    <!-- glitch scanlines, drifting -->
    <g fill="#f5c518">
        <rect class="glitch-a" x="122" y="100" width="198" height="3" opacity="0.35"/>
        <rect class="glitch-b" x="122" y="130" width="198" height="3" opacity="0.25"/>
    </g>

    <!-- pixel dots -->
    <rect x="346" y="32" width="18" height="18" fill="#f5c518"/>
    <g class="logo-ink">
        <rect x="44" y="196" width="26" height="26"/>
    </g>
    <g class="logo-mut">
        <rect x="354" y="184" width="12" height="12"/>
    </g>
</svg>

<style>
    .logo-ink {
        fill: rgb(var(--ink));
    }
    .logo-mut {
        fill: rgb(var(--ink));
        opacity: 0.72;
    }

    /* crown blinking: hard on/off steps for the pixel feel */
    .logo-crown {
        animation: crown-blink 1.4s steps(1, end) infinite;
    }
    @keyframes crown-blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.25;
        }
    }

    /* B pixels flicker to accent color in sequence */
    .b-flicker {
        opacity: 0;
        animation: b-flicker 2.4s steps(1, end) infinite;
    }
    @keyframes b-flicker {
        0% {
            opacity: 1;
        }
        33% {
            opacity: 0;
        }
    }

    /* glitch lines drift left/right */
    .glitch-a {
        animation: glitch-a 2.1s steps(4, end) infinite;
    }
    .glitch-b {
        animation: glitch-b 2.7s steps(4, end) infinite;
    }
    @keyframes glitch-a {
        0%,
        100% {
            transform: translateX(0);
        }
        50% {
            transform: translateX(10px);
        }
    }
    @keyframes glitch-b {
        0%,
        100% {
            transform: translateX(-8px);
        }
        50% {
            transform: translateX(6px);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .logo-crown,
        .b-flicker,
        .glitch-a,
        .glitch-b {
            animation: none;
        }
        .b-flicker {
            opacity: 0;
        }
    }
</style>
