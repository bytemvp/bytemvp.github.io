---
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { SITE_TITLE } from "../consts";
---

<header
  class="sticky top-0 z-50 border-b border-ink/10 bg-white/82 backdrop-blur-xl dark:border-white/10 dark:bg-gray-light/82"
>
  <nav
    class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2 px-4 py-3 md:flex md:justify-between md:gap-4"
  >
    <h2 class="m-0 flex min-w-0 items-center text-base font-bold md:text-lg">
      <a
        class="inline-flex min-w-0 max-w-full items-center gap-2 text-ink transition-colors hover:text-accent-dark dark:text-gray-dark"
        href="/"
      >
        <span class="truncate">{SITE_TITLE}</span>
      </a>
    </h2>
    <div class="flex items-center justify-end gap-2 md:order-3 md:gap-3">
      <ThemeToggle />
      <a
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-ink/10 bg-white/70 text-ink transition-colors hover:border-accent hover:text-accent-dark dark:bg-white/5 dark:text-gray-dark"
        href="https://github.com/bytemvp"
        target="_blank"
        rel="noreferrer"
      >
        <span class="sr-only">打开 Byte MVP 的 GitHub</span>
        <svg class="h-5 w-5" viewBox="0 0 16 16" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
    </div>
    <div class="col-span-2 flex min-w-0 items-center gap-1 overflow-x-auto pb-0.5 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:order-2 md:col-span-1 md:flex-wrap md:justify-center md:gap-2 md:overflow-visible md:pb-0">
      <HeaderLink href="/">首页</HeaderLink>
      <HeaderLink href="/blog">文章</HeaderLink>
      <HeaderLink href="/tools">工具</HeaderLink>
      <HeaderLink href="/about">关于</HeaderLink>
    </div>
  </nav>
</header>
