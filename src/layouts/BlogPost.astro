---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"] & { pubDate?: Date };

const { title, description, pubDate, updatedDate, heroImage, tags = [], sourceUrl, sourceName } = Astro.props;
const isAboutPage = Astro.url.pathname.replace(/\/$/, "") === "/about";
const eyebrow = isAboutPage ? "\u5173\u4e8e" : "\u6587\u7ae0";
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main class="mx-auto w-full max-w-6xl px-4 py-12 md:py-20">
			<article class="space-y-8">
				<header class:list={["hero-shell grid gap-6 rounded-lg p-5 md:p-8", isAboutPage ? "lg:grid-cols-[0.88fr_1.12fr]" : "lg:grid-cols-[0.96fr_1.04fr]"]}>
                <div class:list={["flex flex-col gap-8 rounded-lg border border-[var(--glass-border)] bg-paper-deep p-6 text-ink shadow-card md:p-7", isAboutPage ? "min-h-64 items-center justify-center text-center lg:min-h-full" : "justify-between"]}>
						<div class:list={["space-y-4", { "mx-auto max-w-xl": isAboutPage }]}>
							{
								!isAboutPage && (
                                                                        <p class="neon-pill inline-flex rounded-full px-3 py-1 text-sm font-bold uppercase text-ink dark:text-gray-dark">
										{eyebrow}
									</p>
								)
							}
							<h1 class="text-3xl leading-tight md:text-5xl xl:text-6xl">{title}</h1>
							<p class="text-base font-semibold md:text-lg">{description}</p>
						</div>
						{
							!isAboutPage && (
								<div class="space-y-4 text-sm font-bold">
									<div class="uppercase">
										<FormattedDate date={pubDate} />
									{
										updatedDate && (
											<p class="mt-2 normal-case">
												&#x66F4;&#x65B0;&#x4E8E; <FormattedDate date={updatedDate} />
											</p>
										)
									}
									</div>
									{
										tags.length > 0 && (
										<div class="flex flex-wrap gap-2">
											{tags.map((tag) => (
                                                        <span class="neon-pill rounded-full px-3 py-1 text-xs text-ink dark:text-gray-dark">#{tag}</span>
											))}
										</div>
									)
								}
									{
										sourceUrl && (
                                        <a class="inline-flex text-accent underline decoration-2 underline-offset-4" href={sourceUrl} target="_blank" rel="noreferrer">
											&#x6765;&#x6E90;&#xFF1A;{sourceName || "&#x539F;&#x6587;"}
										</a>
									)
								}
							</div>
							)
						}
					</div>
					{
						heroImage && (
							<img
                                                                class:list={["aspect-[16/9] h-auto w-full rounded-lg border border-[var(--glass-border)] bg-paper-deep object-cover shadow-card lg:h-full", isAboutPage ? "lg:min-h-96" : "lg:min-h-80"]}
								width={1020}
								height={620}
								src={heroImage}
								alt=""
							/>
						)
					}
				</header>

				<div class="surface-card rounded-lg p-6 md:p-10">
					<div class="prose mx-auto max-w-3xl text-gray-dark dark:text-gray">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
