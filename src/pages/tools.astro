---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";

const pageTitle = `在线工具 - ${SITE_TITLE}`;
const pageDescription = "常用在线小工具集合：JSON 格式化、URL 编解码、Base64、时间戳、UUID、密码生成与字数统计。";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
  </head>
  <body>
    <Header />
    <main class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-10 md:py-16">
      <section class="hero-shell rounded-lg p-6 md:p-8">
        <p class="neon-pill inline-flex rounded-full px-4 py-2 text-xs font-bold uppercase tracking-[0.22em] text-accent">Tools</p>
        <div class="mt-4 max-w-3xl space-y-4">
          <h1 class="text-5xl leading-[0.95] text-ink dark:text-gray-dark md:text-7xl">&#x5E38;&#x7528;&#x5728;&#x7EBF;&#x5DE5;&#x5177;</h1>
          <p class="text-lg font-semibold text-gray-dark dark:text-gray md:text-xl">&#x65E5;&#x5E38;&#x5199;&#x4EE3;&#x7801;&#x3001;&#x6392;&#x67E5;&#x95EE;&#x9898;&#x3001;&#x5904;&#x7406;&#x6587;&#x672C;&#x5E38;&#x7528;&#x7684;&#x5C0F;&#x5DE5;&#x5177;&#x3002;&#x6240;&#x6709;&#x8BA1;&#x7B97;&#x90FD;&#x5728;&#x5F53;&#x524D;&#x6D4F;&#x89C8;&#x5668;&#x672C;&#x5730;&#x5B8C;&#x6210;&#x3002;</p>
        </div>
      </section>

      <section class="grid gap-5 lg:grid-cols-2" aria-label="tools">
        <article class="tool-card lg:col-span-2">
          <div class="tool-head">
            <div><p class="tool-kicker">Formatter</p><h2 class="tool-title">JSON &#x683C;&#x5F0F;&#x5316; / &#x538B;&#x7F29;</h2></div>
            <div class="flex flex-wrap gap-2"><button class="tool-button" type="button" data-json-format>&#x683C;&#x5F0F;&#x5316;</button><button class="tool-button secondary" type="button" data-json-minify>&#x538B;&#x7F29;</button></div>
          </div>
          <textarea class="tool-textarea" data-json-input rows="8" placeholder='Paste JSON, e.g. {"name":"Byte MVP"}'></textarea>
          <p class="tool-message" data-json-message></p>
        </article>

        <article class="tool-card">
          <div class="tool-head"><div><p class="tool-kicker">URL</p><h2 class="tool-title">URL &#x7F16;&#x7801; / &#x89E3;&#x7801;</h2></div></div>
          <textarea class="tool-textarea" data-url-input rows="5" placeholder="URL or text"></textarea>
          <div class="mt-3 flex flex-wrap gap-2"><button class="tool-button" type="button" data-url-encode>&#x7F16;&#x7801;</button><button class="tool-button secondary" type="button" data-url-decode>&#x89E3;&#x7801;</button></div>
          <textarea class="tool-textarea mt-3" data-url-output rows="5" placeholder="Result" readonly></textarea>
          <p class="tool-message" data-url-message></p>
        </article>

        <article class="tool-card">
          <div class="tool-head"><div><p class="tool-kicker">Base64</p><h2 class="tool-title">Base64 &#x7F16;&#x7801; / &#x89E3;&#x7801;</h2></div></div>
          <textarea class="tool-textarea" data-base64-input rows="5" placeholder="Text"></textarea>
          <div class="mt-3 flex flex-wrap gap-2"><button class="tool-button" type="button" data-base64-encode>&#x7F16;&#x7801;</button><button class="tool-button secondary" type="button" data-base64-decode>&#x89E3;&#x7801;</button></div>
          <textarea class="tool-textarea mt-3" data-base64-output rows="5" placeholder="Result" readonly></textarea>
          <p class="tool-message" data-base64-message></p>
        </article>

        <article class="tool-card">
          <div class="tool-head"><div><p class="tool-kicker">Time</p><h2 class="tool-title">&#x65F6;&#x95F4;&#x6233;&#x8F6C;&#x6362;</h2></div><button class="tool-button secondary" type="button" data-time-now>&#x5F53;&#x524D;&#x65F6;&#x95F4;</button></div>
          <label class="tool-label" for="timestamp-input">Unix &#x65F6;&#x95F4;&#x6233;</label>
          <input id="timestamp-input" class="tool-input" data-timestamp-input placeholder="seconds or milliseconds" />
          <button class="tool-button mt-3" type="button" data-time-convert>&#x8F6C;&#x65E5;&#x671F;</button>
          <div class="tool-result mt-4" data-time-output>&#x7B49;&#x5F85;&#x8F93;&#x5165;&#x65F6;&#x95F4;&#x6233;</div>
        </article>

        <article class="tool-card">
          <div class="tool-head"><div><p class="tool-kicker">Generator</p><h2 class="tool-title">UUID &#x751F;&#x6210;&#x5668;</h2></div><button class="tool-button" type="button" data-uuid-generate>&#x751F;&#x6210;</button></div>
          <div class="tool-result break-all" data-uuid-output>&#x70B9;&#x51FB;&#x751F;&#x6210; UUID</div>
          <button class="tool-link" type="button" data-copy-target="[data-uuid-output]">&#x590D;&#x5236;&#x7ED3;&#x679C;</button>
        </article>

        <article class="tool-card">
          <div class="tool-head"><div><p class="tool-kicker">Security</p><h2 class="tool-title">&#x968F;&#x673A;&#x5BC6;&#x7801;&#x751F;&#x6210;&#x5668;</h2></div></div>
          <label class="tool-label" for="password-length">&#x957F;&#x5EA6;&#xFF1A;<span data-password-length-text>16</span></label>
          <input id="password-length" class="w-full accent-accent" data-password-length type="range" min="8" max="48" value="16" />
          <button class="tool-button mt-4" type="button" data-password-generate>&#x751F;&#x6210;&#x5BC6;&#x7801;</button>
          <div class="tool-result mt-4 break-all" data-password-output>&#x70B9;&#x51FB;&#x751F;&#x6210;&#x968F;&#x673A;&#x5BC6;&#x7801;</div>
          <button class="tool-link" type="button" data-copy-target="[data-password-output]">&#x590D;&#x5236;&#x7ED3;&#x679C;</button>
        </article>

        <article class="tool-card">
          <div class="tool-head"><div><p class="tool-kicker">Text</p><h2 class="tool-title">&#x5B57;&#x6570;&#x7EDF;&#x8BA1;</h2></div></div>
          <textarea class="tool-textarea" data-count-input rows="7" placeholder="Paste text"></textarea>
          <div class="mt-4 grid grid-cols-2 gap-3 text-sm md:grid-cols-4">
            <div class="tool-stat"><span data-count-chars>0</span><small>&#x5B57;&#x7B26;</small></div>
            <div class="tool-stat"><span data-count-cn>0</span><small>&#x4E2D;&#x6587;</small></div>
            <div class="tool-stat"><span data-count-words>0</span><small>&#x82F1;&#x6587;&#x8BCD;</small></div>
            <div class="tool-stat"><span data-count-lines>0</span><small>&#x884C;&#x6570;</small></div>
          </div>
        </article>
      </section>
    </main>
    <Footer />

    <script is:inline>
      const $ = (selector) => document.querySelector(selector);
      const messages = {
        jsonOk: "\u683c\u5f0f\u5316\u6210\u529f",
        jsonMinOk: "\u538b\u7f29\u6210\u529f",
        jsonError: "JSON \u683c\u5f0f\u4e0d\u6b63\u786e\uff0c\u8bf7\u68c0\u67e5\u540e\u91cd\u8bd5",
        encodeOk: "\u7f16\u7801\u5b8c\u6210",
        decodeOk: "\u89e3\u7801\u5b8c\u6210",
        urlError: "URL \u7f16\u7801\u683c\u5f0f\u4e0d\u6b63\u786e",
        base64Error: "Base64 \u683c\u5f0f\u4e0d\u6b63\u786e",
        invalidNumber: "\u8bf7\u8f93\u5165\u6709\u6548\u6570\u5b57",
        invalidDate: "\u8f6c\u6362\u7ed3\u679c\u65e0\u6548\uff0c\u8bf7\u68c0\u67e5\u65f6\u95f4\u6233",
        copied: "\u5df2\u590d\u5236",
        copyFailed: "\u590d\u5236\u5931\u8d25",
        copyResult: "\u590d\u5236\u7ed3\u679c"
      };
      const elements = {
        jsonInput: $("[data-json-input]"),
        jsonMessage: $("[data-json-message]"),
        jsonFormat: $("[data-json-format]"),
        jsonMinify: $("[data-json-minify]"),
        urlInput: $("[data-url-input]"),
        urlOutput: $("[data-url-output]"),
        urlMessage: $("[data-url-message]"),
        urlEncode: $("[data-url-encode]"),
        urlDecode: $("[data-url-decode]"),
        base64Input: $("[data-base64-input]"),
        base64Output: $("[data-base64-output]"),
        base64Message: $("[data-base64-message]"),
        base64Encode: $("[data-base64-encode]"),
        base64Decode: $("[data-base64-decode]"),
        timestampInput: $("[data-timestamp-input]"),
        timeOutput: $("[data-time-output]"),
        timeNow: $("[data-time-now]"),
        timeConvert: $("[data-time-convert]"),
        uuidOutput: $("[data-uuid-output]"),
        uuidGenerate: $("[data-uuid-generate]"),
        passwordLength: $("[data-password-length]"),
        passwordLengthText: $("[data-password-length-text]"),
        passwordOutput: $("[data-password-output]"),
        passwordGenerate: $("[data-password-generate]"),
        countInput: $("[data-count-input]"),
        countChars: $("[data-count-chars]"),
        countCn: $("[data-count-cn]"),
        countWords: $("[data-count-words]"),
        countLines: $("[data-count-lines]")
      };
      const setText = (element, text) => {
        if (element && element.textContent !== text) element.textContent = text;
      };
      const setValue = (element, value) => {
        if (element && element.value !== value) element.value = value;
      };
      const runAfterPaint = (task) => requestAnimationFrame(() => setTimeout(task, 0));
      const toBase64 = (value) => {
        const bytes = new TextEncoder().encode(value);
        const chunkSize = 0x8000;
        const chunks = [];
        for (let index = 0; index < bytes.length; index += chunkSize) {
          chunks.push(String.fromCharCode(...bytes.subarray(index, index + chunkSize)));
        }
        const binary = chunks.join("");
        return btoa(binary);
      };
      const fromBase64 = (value) => {
        const binary = atob(value);
        const bytes = new Uint8Array(binary.length);
        for (let index = 0; index < binary.length; index += 1) {
          bytes[index] = binary.charCodeAt(index);
        }
        return new TextDecoder().decode(bytes);
      };

      elements.jsonFormat?.addEventListener("click", () => {
        runAfterPaint(() => {
          const input = elements.jsonInput;
          if (!input) return;
          try {
            input.value = JSON.stringify(JSON.parse(input.value), null, 2);
            setText(elements.jsonMessage, messages.jsonOk);
          } catch {
            setText(elements.jsonMessage, messages.jsonError);
          }
        });
      });
      elements.jsonMinify?.addEventListener("click", () => {
        runAfterPaint(() => {
          const input = elements.jsonInput;
          if (!input) return;
          try {
            input.value = JSON.stringify(JSON.parse(input.value));
            setText(elements.jsonMessage, messages.jsonMinOk);
          } catch {
            setText(elements.jsonMessage, messages.jsonError);
          }
        });
      });
      elements.urlEncode?.addEventListener("click", () => {
        setValue(elements.urlOutput, encodeURIComponent(elements.urlInput?.value || ""));
        setText(elements.urlMessage, messages.encodeOk);
      });
      elements.urlDecode?.addEventListener("click", () => {
        try {
          setValue(elements.urlOutput, decodeURIComponent(elements.urlInput?.value || ""));
          setText(elements.urlMessage, messages.decodeOk);
        } catch {
          setText(elements.urlMessage, messages.urlError);
        }
      });
      elements.base64Encode?.addEventListener("click", () => {
        runAfterPaint(() => {
          setValue(elements.base64Output, toBase64(elements.base64Input?.value || ""));
          setText(elements.base64Message, messages.encodeOk);
        });
      });
      elements.base64Decode?.addEventListener("click", () => {
        runAfterPaint(() => {
          try {
            setValue(elements.base64Output, fromBase64((elements.base64Input?.value || "").trim()));
            setText(elements.base64Message, messages.decodeOk);
          } catch {
            setText(elements.base64Message, messages.base64Error);
          }
        });
      });

      const renderTime = (date) => {
        if (Number.isNaN(date.getTime())) {
          setText(elements.timeOutput, messages.invalidDate);
          return;
        }
        setText(elements.timeOutput, `${date.toLocaleString()} | ISO: ${date.toISOString()}`);
      };
      elements.timeNow?.addEventListener("click", () => {
        const now = new Date();
        setValue(elements.timestampInput, String(now.getTime()));
        renderTime(now);
      });
      elements.timeConvert?.addEventListener("click", () => {
        const rawValue = (elements.timestampInput?.value || "").trim();
        const timestamp = Number(rawValue);
        if (!Number.isFinite(timestamp)) {
          setText(elements.timeOutput, messages.invalidNumber);
          return;
        }
        renderTime(new Date(rawValue.length === 10 ? timestamp * 1000 : timestamp));
      });
      elements.uuidGenerate?.addEventListener("click", () => setText(elements.uuidOutput, crypto.randomUUID()));

      elements.passwordLength?.addEventListener("input", () => setText(elements.passwordLengthText, elements.passwordLength.value));
      elements.passwordGenerate?.addEventListener("click", () => {
        const chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*_-+=?";
        const values = crypto.getRandomValues(new Uint32Array(Number(elements.passwordLength?.value || 16)));
        let password = "";
        for (let index = 0; index < values.length; index += 1) {
          password += chars[values[index] % chars.length];
        }
        setText(elements.passwordOutput, password);
      });

      let countTimer = 0;
      const renderCounts = () => {
        const value = elements.countInput?.value || "";
        let cn = 0;
        let lines = value.length > 0 ? 1 : 0;
        for (let index = 0; index < value.length; index += 1) {
          const code = value.charCodeAt(index);
          if (code >= 0x4e00 && code <= 0x9fa5) cn += 1;
          if (value[index] === "\n") lines += 1;
        }
        setText(elements.countChars, String(value.length));
        setText(elements.countCn, String(cn));
        setText(elements.countWords, String((value.match(/[A-Za-z0-9]+(?:[-'][A-Za-z0-9]+)*/g) || []).length));
        setText(elements.countLines, String(lines));
      };
      const scheduleCounts = () => {
        window.clearTimeout(countTimer);
        countTimer = window.setTimeout(renderCounts, 120);
      };
      elements.countInput?.addEventListener("input", scheduleCounts, { passive: true });

      document.querySelectorAll("[data-copy-target]").forEach((button) => {
        let resetTimer = 0;
        const target = $(button.dataset.copyTarget);
        button.addEventListener("click", async () => {
          const text = (target?.value || target?.textContent || "").trim();
          if (!text) return;
          try {
            if (navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(text);
            } else {
              const textarea = document.createElement("textarea");
              textarea.value = text;
              textarea.style.position = "fixed";
              textarea.style.opacity = "0";
              document.body.append(textarea);
              textarea.select();
              document.execCommand("copy");
              textarea.remove();
            }
            button.textContent = messages.copied;
          } catch {
            button.textContent = messages.copyFailed;
          }
          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => (button.textContent = messages.copyResult), 1200);
        });
      });
    </script>
  </body>
</html>

<style>
  .tool-card { contain: layout paint; border: 1px solid var(--glass-border); border-radius: 0.5rem; background: var(--glass); padding: 1.25rem; box-shadow: var(--box-shadow); transition: border-color 0.18s ease, box-shadow 0.18s ease; }
  .tool-card:hover { border-color: var(--accent); box-shadow: var(--pop-shadow); }
  .tool-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .tool-kicker { margin: 0 0 0.25rem; color: var(--accent); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .tool-title { font-size: 1.35rem; line-height: 1.08; letter-spacing: 0.01em; }
  .tool-textarea, .tool-input { width: 100%; border: 1px solid var(--glass-border); border-radius: 0.5rem; background: var(--paper); padding: 0.9rem 1rem; color: rgb(var(--ink)); outline: none; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.42); }
  [data-theme="dark"] .tool-textarea, [data-theme="dark"] .tool-input { background: var(--paper-deep); color: rgb(var(--gray-dark)); box-shadow: inset 0 1px 0 rgba(234, 225, 210, 0.08); }
  .tool-textarea:focus, .tool-input:focus { border-color: var(--accent); box-shadow: 0 0 0 4px rgba(156, 47, 47, 0.16); }
  .tool-button { min-height: 2.5rem; border: 1px solid transparent; border-radius: 0.5rem; background: var(--accent); padding: 0 1rem; color: var(--paper); font-weight: 700; box-shadow: var(--soft-shadow); transition: opacity 0.18s ease, box-shadow 0.18s ease; }
  @media (max-width: 520px) { .tool-button { flex: 1 1 auto; } .tool-head > .flex { width: 100%; } }
  .tool-button:hover { opacity: 0.92; box-shadow: var(--pop-shadow); }
  .tool-button:focus-visible, .tool-link:focus-visible { outline: 3px solid var(--indigo); outline-offset: 3px; }
  .tool-button.secondary { border-color: var(--glass-border); background: var(--paper-deep); color: rgb(var(--ink)); box-shadow: none; }
  [data-theme="dark"] .tool-button { color: var(--paper); }
  [data-theme="dark"] .tool-button.secondary { background: var(--paper-deep); color: rgb(var(--gray-dark)); }
  .tool-label { display: block; margin-bottom: 0.45rem; font-weight: 700; }
  .tool-result { min-height: 3rem; border: 1px solid var(--glass-border); border-radius: 0.5rem; background: var(--paper); padding: 0.85rem 1rem; color: rgb(var(--ink)); font-weight: 700; }
  [data-theme="dark"] .tool-result { background: var(--paper-deep); color: rgb(var(--gray-dark)); }
  .tool-message { min-height: 1.5rem; margin: 0.65rem 0 0; color: var(--accent-dark); font-size: 0.9rem; font-weight: 700; }
  .tool-link { margin-top: 0.75rem; color: var(--accent-dark); font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .tool-stat { border: 1px solid var(--glass-border); border-radius: 0.5rem; background: var(--paper); padding: 0.85rem; text-align: center; }
  [data-theme="dark"] .tool-stat { background: var(--paper-deep); }
  .tool-stat span { display: block; color: rgb(var(--ink)); font-size: 1.35rem; font-weight: 700; }
  [data-theme="dark"] .tool-stat span { color: rgb(var(--gray-dark)); }
  .tool-stat small { color: rgb(var(--gray)); font-weight: 700; }
</style>
