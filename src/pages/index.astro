---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getCollection } from "astro:content";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featuredPost, ...recentPosts] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={featuredPost?.data.heroImage} />
	</head>
	<body>
		<Header />
		<main class="mx-auto flex max-w-6xl flex-col gap-14 px-4 py-10 md:gap-20 md:py-16">
			<section class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr]" aria-labelledby="hero-title">
				<div class="space-y-7">
					<div class="inline-flex items-center gap-2 rounded-full border border-ink/15 bg-white/85 px-4 py-2 text-sm font-bold text-ink shadow-pop dark:bg-gray-light dark:text-gray-dark">
						<span class="h-3 w-3 rounded-full bg-candy"></span>
						给小团队的清爽实践
					</div>
					<div class="space-y-5">
						<h1 id="hero-title" class="max-w-4xl text-ink dark:text-gray-dark">
							用更轻盈的方式，记录可落地的产品与前端思考。
						</h1>
						<p class="max-w-2xl text-xl font-semibold text-gray-dark dark:text-gray">
							{SITE_DESCRIPTION}
						</p>
					</div>
					<div class="flex flex-wrap gap-3">
						<a class="inline-flex min-h-12 items-center justify-center rounded-full border border-ink/15 bg-candy px-6 font-bold text-ink shadow-pop transition-transform hover:-translate-y-1" href="/blog">
							浏览文章
						</a>
						<a class="inline-flex min-h-12 items-center justify-center rounded-full border border-ink/15 bg-lime px-6 font-bold text-ink shadow-pop transition-transform hover:-translate-y-1" href="/about">
							了解作者
						</a>
					</div>
				</div>

				<div class="relative">
					<div class="absolute -left-4 top-8 hidden h-20 w-20 rotate-12 rounded-[1.5rem] border border-ink/15 bg-mango shadow-pop md:block"></div>
					<div class="absolute -right-2 bottom-10 hidden h-16 w-16 rounded-full border border-ink/15 bg-aqua shadow-pop md:block"></div>
					<div class="relative rounded-3xl border border-ink/15 bg-white/88 p-5 shadow-soft dark:bg-gray-light">
						<div class="grid gap-4">
							<div class="rounded-2xl border border-ink/15 bg-mango p-5 text-ink">
								<p class="text-sm font-bold uppercase">已发布</p>
								<p class="mt-1 text-5xl font-bold leading-none">{posts.length}</p>
								<p class="mt-2 font-semibold">篇笔记、指南与实验</p>
							</div>
							<div class="grid grid-cols-2 gap-4">
								<div class="rounded-2xl border border-ink/15 bg-lime p-4 text-ink">
									<p class="text-sm font-bold uppercase">技术栈</p>
									<p class="mt-2 text-2xl font-bold">Astro</p>
								</div>
								<div class="rounded-2xl border border-ink/15 bg-aqua p-4 text-ink">
									<p class="text-sm font-bold uppercase">风格</p>
									<p class="mt-2 text-2xl font-bold">小清新</p>
								</div>
							</div>
							<div class="rounded-2xl border border-ink/15 bg-bubble p-4 text-ink">
								<p class="text-sm font-bold uppercase">方向</p>
								<p class="mt-2 text-2xl font-bold">清晰表达，稳步迭代。</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			{
				featuredPost && (
					<section aria-labelledby="featured-title" class="space-y-5">
						<div class="flex flex-wrap items-end justify-between gap-4">
							<div>
								<p class="mb-2 text-sm font-bold uppercase text-accent">精选</p>
								<h2 id="featured-title">从这篇开始读</h2>
							</div>
							<a class="font-bold text-accent underline decoration-[3px] underline-offset-4" href="/blog">
								查看全部
							</a>
						</div>
						<article class="grid overflow-hidden rounded-3xl border border-ink/15 bg-white/88 shadow-soft dark:bg-gray-light lg:grid-cols-[1.08fr_0.92fr]">
							<img
								class="h-full min-h-72 w-full object-cover"
								src={featuredPost.data.heroImage}
								alt=""
								width="960"
								height="540"
								loading="lazy"
							/>
							<div class="flex flex-col justify-between gap-8 p-6 md:p-8">
								<div class="space-y-4">
									<p class="inline-flex rounded-full bg-lime px-4 py-2 text-sm font-bold text-ink">
										<FormattedDate date={featuredPost.data.pubDate} />
									</p>
									<h3>{featuredPost.data.title}</h3>
									<p class="text-lg font-semibold text-gray-dark dark:text-gray">
										{featuredPost.data.description}
									</p>
								</div>
								<a class="inline-flex w-fit min-h-12 items-center justify-center rounded-full border border-ink/15 bg-candy px-6 font-bold text-ink shadow-pop transition-transform hover:-translate-y-1" href={`/blog/${featuredPost.id}/`}>
									阅读全文
								</a>
							</div>
						</article>
					</section>
				)
			}

			<section class="space-y-5" aria-labelledby="latest-title">
				<div>
					<p class="mb-2 text-sm font-bold uppercase text-accent">最近更新</p>
					<h2 id="latest-title">轻量记录</h2>
				</div>
				<div class="grid gap-5 md:grid-cols-3">
					{
						recentPosts.slice(0, 3).map((post, index) => (
							<article class:list={[
								"flex min-h-72 flex-col justify-between rounded-3xl border border-ink/15 p-5 text-ink shadow-pop transition-transform hover:-translate-y-1",
								["bg-aqua", "bg-lime", "bg-mango"][index % 3],
							]}>
								<div class="space-y-4">
									<p class="rounded-full bg-white/80 px-3 py-1 text-sm font-bold">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h3 class="text-2xl">{post.data.title}</h3>
									<p class="font-semibold">{post.data.description}</p>
								</div>
								<a class="mt-6 font-bold underline decoration-[3px] underline-offset-4" href={`/blog/${post.id}/`}>
									继续阅读
								</a>
							</article>
						))
					}
				</div>
			</section>

			<section class="flex flex-wrap items-center justify-between gap-6 rounded-3xl border border-ink/15 bg-white/88 p-6 shadow-soft dark:bg-gray-light md:p-8" aria-labelledby="cta-title">
				<div class="max-w-2xl">
					<p class="mb-2 text-sm font-bold uppercase text-accent">文章归档</p>
					<h2 id="cta-title">更多笔记，慢慢翻看。</h2>
				</div>
				<a class="inline-flex min-h-12 items-center justify-center rounded-full border border-ink/15 bg-bubble px-6 font-bold text-ink shadow-pop transition-transform hover:-translate-y-1" href="/blog">
					查看所有文章
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
