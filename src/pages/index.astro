---
import BaseHead from "../components/BaseHead.astro";
import LogoAnimated from "../components/LogoAnimated.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const product = {
    name: "NightRest（夜息）",
    tagline: "跨平台显示器亮度控制与护眼滤镜",
    description:
        "用 Rust 编写的开源桌面工具：通过 DDC/CI 直接调节外接显示器亮度，叠加软件护眼滤镜（屏幕变暗或暖色着色），按本地时区在昼夜间自动切换。Windows / Linux / macOS 一套 GUI、各平台原生安装包；核心协议与滤镜逻辑内置单元测试。",
    repo: "https://github.com/bytemvp/night-rest",
    clone: "git clone https://github.com/bytemvp/night-rest.git",
    features: [
        {
            title: "DDC/CI 亮度控制",
            description:
                "Get / Set / Adjust 0–100%：直接向显示器发送 VESA 标准指令，无需厂商驱动，精细调节外接屏幕亮度。",
        },
        {
            title: "屏幕滤镜",
            description:
                "黑色 / 绿色 / 暖色（琥珀）或任意自定义 RGB：纯软件叠加、点击穿透，只变暗或着色屏幕，不改动硬件亮度。",
        },
        {
            title: "昼夜定时切换",
            description:
                "按本地时区自动切换日间 / 夜间滤镜，支持跨午夜时段；定时开启时滤镜强度与颜色控件会被锁定，切换即时生效——白天开启则滤镜立即归零，入夜瞬间恢复。",
        },
        {
            title: "多显示器支持",
            description:
                "列出所有检测到的显示器并按索引分别控制；Windows 下笔记本内屏经 WMI 亮度接口同样可调。",
        },
        {
            title: "滑杆式 GUI",
            description:
                "基于 Tauri 2 + React 的滑杆式图形界面：每台显示器一张带连接器标注的亮度滑杆卡片，滤镜与日程以卡片呈现，开箱即用。",
        },
        {
            title: "原生安装包",
            description:
                "Windows 10/11 NSIS 安装器（x64）、macOS .dmg（Apple Silicon 与 Intel，拖入 Applications）、Debian / Ubuntu .deb、Fedora / RHEL .rpm；apt / dnf 同名包原地升级。",
        },
    ],
};
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body class="flex min-h-screen flex-col">
        <Header />
        <main class="flex w-full flex-1 flex-col gap-14 py-10 md:gap-20 md:py-16">
            <div class="mx-auto w-[calc(100%-1rem)] max-w-6xl">
                <LogoAnimated />
            </div>
            <section
                id="product"
                class="mx-auto w-[calc(100%-1rem)] max-w-6xl scroll-mt-24 space-y-6"
                aria-labelledby="product-title"
            >
                <div>
                    <p
                        class="text-sm font-bold uppercase tracking-[0.18em] text-accent"
                    >
                        Products
                    </p>
                    <h2 id="product-title" class="mt-2 text-3xl md:text-4xl">
                        产品介绍
                    </h2>
                </div>

                <article class="surface-card rounded-lg p-6 md:p-9">
                    <div
                        class="grid min-w-0 gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center"
                    >
                        <div class="min-w-0">
                            <h3
                                class="text-2xl font-bold text-ink dark:text-gray-dark md:text-3xl"
                            >
                                {product.name}
                            </h3>
                            <p class="mt-2 font-bold text-accent">
                                {product.tagline}
                            </p>
                            <p
                                class="mt-4 text-sm leading-relaxed text-gray-dark dark:text-gray md:text-base"
                            >
                                {product.description}
                            </p>
                            <div class="mt-6 flex flex-wrap gap-3">
                                <a
                                    class="cta-primary inline-flex min-h-11 items-center justify-center rounded-lg px-5 text-sm font-bold text-white transition hover:shadow-pop"
                                    href={product.repo}
                                    target="_blank"
                                    rel="noreferrer"
                                >
                                    GitHub 仓库 →
                                </a>
                                <a
                                    class="cta-secondary inline-flex min-h-11 items-center justify-center rounded-lg px-5 text-sm font-bold text-ink transition hover:text-accent-dark hover:shadow-card dark:text-gray-dark"
                                    href={`${product.repo}#installation`}
                                    target="_blank"
                                    rel="noreferrer"
                                >
                                    安装与使用
                                </a>
                            </div>
                        </div>
                        <div
                            class="min-w-0 rounded-lg border border-[var(--glass-border)] bg-paper-deep p-4 dark:bg-paper-deep"
                        >
                            <p
                                class="mb-3 text-xs font-bold uppercase tracking-[0.14em] text-gray"
                            >
                                从源码构建
                            </p>
                            <pre
                                class="overflow-x-auto rounded-md bg-[#1c2629] p-4 text-xs leading-relaxed text-[#d6e0e0]"><code>{product.clone}
cd night-rest
npm install
npm run tauri build</code></pre>
                            <p class="mt-3 text-xs text-gray">
                                前置要求：Rust stable（Windows 需 MSVC）与 Node.js ≥ 20。构建产物在 <code>target/release/bundle/</code>（nsis / dmg / deb / rpm）；本地调试用 <code>npm run tauri dev</code>。
                            </p>
                        </div>
                    </div>
                </article>

                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {
                        product.features.map((feature) => (
                            <article class="lift-card surface-card rounded-lg p-5">
                                <h3 class="text-base font-bold text-ink dark:text-gray-dark">
                                    {feature.title}
                                </h3>
                                <p class="mt-2 text-sm leading-relaxed text-gray-dark dark:text-gray">
                                    {feature.description}
                                </p>
                            </article>
                        ))
                    }
                </div>
            </section>
        </main>
        <Footer />
    </body>
</html>
