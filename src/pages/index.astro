---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getCollection } from "astro:content";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featuredPost, ...recentPosts] = posts;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={featuredPost?.data.heroImage} />
	</head>
	<body>
		<Header />
		<main class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 py-10 md:gap-16 md:py-16">
			<section class="border-b border-ink/10 pb-10 md:pb-14" aria-labelledby="hero-title">
				<div class="max-w-3xl space-y-6">
					<p class="text-sm font-bold uppercase tracking-[0.18em] text-accent">Byte MVP</p>
					<h1 id="hero-title" class="text-4xl text-ink dark:text-gray-dark md:text-6xl">
						记录产品、前端与个人创作的轻量实践。
					</h1>
					<p class="max-w-2xl text-lg text-gray-dark dark:text-gray">
						{SITE_DESCRIPTION}
					</p>
					<div class="flex flex-wrap gap-3">
						<a class="inline-flex min-h-11 items-center justify-center rounded-lg bg-ink px-5 font-bold text-white transition-colors hover:bg-accent-dark dark:bg-accent dark:text-[#142326] dark:hover:bg-accent-dark" href="/blog">
							浏览文章
						</a>
						<a class="inline-flex min-h-11 items-center justify-center rounded-lg border border-ink/15 bg-white/70 px-5 font-bold text-ink transition-colors hover:border-accent hover:text-accent-dark dark:border-white/10 dark:bg-white/5 dark:text-gray-dark dark:hover:border-accent" href="/about">
							关于作者
						</a>
					</div>
				</div>
			</section>

			{
				featuredPost && (
					<section aria-labelledby="featured-title" class="space-y-4">
						<div class="flex flex-wrap items-center justify-between gap-3">
							<h2 id="featured-title" class="text-2xl md:text-3xl">推荐阅读</h2>
							<a class="font-bold text-accent underline decoration-2 underline-offset-4" href="/blog">
								全部文章
							</a>
						</div>
						<article class="grid overflow-hidden rounded-xl border border-ink/10 bg-white/82 shadow-card dark:bg-gray-light lg:grid-cols-[0.95fr_1.05fr]">
							<img
								class="h-64 w-full object-cover lg:h-full"
								src={featuredPost.data.heroImage}
								alt=""
								width="960"
								height="540"
								loading="lazy"
							/>
							<div class="flex flex-col justify-between gap-6 p-5 md:p-7">
								<div class="space-y-3">
									<p class="text-sm font-bold text-accent">
										<FormattedDate date={featuredPost.data.pubDate} />
									</p>
									<h3 class="text-2xl md:text-4xl">{featuredPost.data.title}</h3>
									<p class="text-base text-gray-dark dark:text-gray">
										{featuredPost.data.description}
									</p>
								</div>
								<a class="font-bold text-ink underline decoration-2 underline-offset-4 dark:text-gray-dark" href={`/blog/${featuredPost.id}/`}>
									阅读全文
								</a>
							</div>
						</article>
					</section>
				)
			}

			<section class="space-y-5" aria-labelledby="latest-title">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<h2 id="latest-title" class="text-2xl md:text-3xl">最新记录</h2>
					<span class="text-sm font-bold text-gray">{posts.length} 篇文章</span>
				</div>
				<div class="divide-y divide-ink/10 rounded-xl border border-ink/10 bg-white/72 shadow-card dark:bg-gray-light">
					{
						recentPosts.slice(0, 4).map((post) => (
							<article>
								<a class="grid gap-3 p-5 transition-colors hover:bg-white/70 dark:hover:bg-white/5 md:grid-cols-[9rem_1fr_auto] md:items-center" href={`/blog/${post.id}/`}>
									<p class="text-sm font-bold text-accent">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<div class="space-y-1">
										<h3 class="text-xl md:text-2xl">{post.data.title}</h3>
										<p class="text-sm text-gray-dark dark:text-gray">{post.data.description}</p>
									</div>
									<span class="font-bold text-ink dark:text-gray-dark">阅读</span>
								</a>
							</article>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
