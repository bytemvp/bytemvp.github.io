---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const projects = [
	{
		name: "Byte MVP",
		description: "AI 资讯聚合与产品实践分享平台",
	},
	{
		name: "AI 工作流",
		description: "探索 AI 在日常开发中的实际应用方式",
	},
	{
		name: "开源工具",
		description: "轻量级开发工具与效率提升方案",
	},
];

const navLinks = [
	{
		title: "博客",
		description: "浏览 AI 资讯与产品实践文章",
		href: "/blog",
	},
	{
		title: "关于",
		description: "了解 Byte MVP 的故事与理念",
		href: "/about",
	},
	{
		title: "工具",
		description: "在线开发工具与实用小应用",
		href: "/tools",
	},
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto flex w-full max-w-6xl flex-col gap-14 px-4 py-10 md:gap-20 md:py-16">
			<section class="flex min-h-[32rem] flex-col items-center justify-center text-center" aria-labelledby="hero-title">
				<div class="hero-shell rounded-lg p-5 md:p-9">
					<p class="neon-pill inline-flex rounded-full px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-accent">Byte MVP</p>
					<h1 id="hero-title" class="mt-8 max-w-4xl text-5xl leading-[0.98] text-ink dark:text-gray-dark md:text-7xl">
						聚合 AI 动态，记录工具与产品实践。
					</h1>
					<p class="mt-7 max-w-2xl text-lg font-semibold text-gray-dark dark:text-gray md:text-xl">
						{SITE_DESCRIPTION}
					</p>
					<div class="mt-10 flex flex-wrap justify-center gap-3">
						<a class="cta-primary inline-flex min-h-12 items-center justify-center rounded-lg px-6 font-bold text-white transition hover:shadow-pop" href="/blog">
							浏览 AI 资讯
						</a>
						<a class="cta-secondary inline-flex min-h-12 items-center justify-center rounded-lg px-6 font-bold text-ink transition hover:text-accent-dark hover:shadow-card dark:text-gray-dark" href="/about">
							关于 ByteMVP
						</a>
					</div>
				</div>
			</section>

			<section class="space-y-6" aria-labelledby="showcase-title">
				<div>
					<p class="text-sm font-bold uppercase tracking-[0.18em] text-accent">Projects</p>
					<h2 id="showcase-title" class="mt-2 text-3xl md:text-4xl">项目展示</h2>
				</div>
				<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{projects.map((project) => (
						<article class="lift-card surface-card rounded-lg p-5">
							<h3 class="text-xl font-bold">{project.name}</h3>
							<p class="mt-2 text-sm text-gray-dark dark:text-gray">{project.description}</p>
						</article>
					))}
				</div>
			</section>

			<section class="space-y-6" aria-labelledby="nav-title">
				<div>
					<p class="text-sm font-bold uppercase tracking-[0.18em] text-accent">Explore</p>
					<h2 id="nav-title" class="mt-2 text-3xl md:text-4xl">探索站点</h2>
				</div>
				<div class="grid gap-4 md:grid-cols-3">
					{navLinks.map((link) => (
						<a
							href={link.href}
							class="lift-card surface-card group rounded-lg p-5 transition hover:shadow-pop"
						>
							<h3 class="text-xl font-bold text-ink transition group-hover:text-accent dark:text-gray-dark">{link.title}</h3>
							<p class="mt-2 text-sm text-gray-dark dark:text-gray">{link.description}</p>
							<span class="mt-4 inline-block font-bold text-accent transition group-hover:translate-x-1">了解更多 →</span>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
