---
import BaseHead from "../components/BaseHead.astro";
import LogoAnimated from "../components/LogoAnimated.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body class="flex min-h-screen flex-col">
        <Header />
        <main class="flex w-full flex-1 flex-col items-center justify-center gap-8 py-12 md:py-20 text-center">
            <div class="mx-auto w-[calc(100%-1rem)] max-w-6xl space-y-8">
                <LogoAnimated />

                <div class="mx-auto max-w-2xl space-y-4">
                    <h1 class="text-3xl font-extrabold tracking-tight text-ink dark:text-gray-dark md:text-5xl">
                        Build Fast. <span class="gradient-text">Be the MVP.</span>
                    </h1>
                    <p class="text-base text-ink/70 dark:text-gray md:text-lg leading-relaxed">
                        专注高品质极简工具开发与实用生产力精选，让效率翻倍。
                    </p>
                    <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
                        <a
                            href="/tools"
                            class="cta-primary inline-flex min-h-11 items-center justify-center rounded-xl px-6 text-sm font-bold text-white transition hover:shadow-pop active:scale-95"
                        >
                            探索 AI 工具箱 →
                        </a>
                        <a
                            href="https://github.com/bytemvp"
                            target="_blank"
                            rel="noreferrer"
                            class="cta-secondary inline-flex min-h-11 items-center justify-center rounded-xl px-6 text-sm font-bold text-ink transition hover:text-accent-dark hover:shadow-card dark:text-gray-dark active:scale-95"
                        >
                            GitHub 组织
                        </a>
                    </div>
                </div>
            </div>
        </main>
        <Footer />
    </body>
</html>
