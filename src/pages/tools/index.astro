---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SUPABASE_URL, SUPABASE_ANON_KEY, TOOL_CATEGORIES } from "../../consts";
import toolsData from "../../data/tools.json";
import type { ToolItem } from "../../lib/supabase";

const presetTools = toolsData as ToolItem[];

const categoryCounts: Record<string, number> = {
    全部: presetTools.length,
};

presetTools.forEach((t) => {
    categoryCounts[t.category] = (categoryCounts[t.category] || 0) + 1;
});

const pageTitle = `AI 工具精选 · ${SITE_TITLE}`;
const pageDescription = "精选实用好用的 AI 生产力工具导航，涵盖代码编程、视觉设计、智能对话、知识管理与音视频生成。";
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title={pageTitle} description={pageDescription} />
    </head>
    <body class="flex min-h-screen flex-col">
        <Header />

        <main
            class="flex w-full flex-1 flex-col gap-8 py-8 md:gap-12 md:py-12"
            id="tools-page-container"
            data-supabase-url={SUPABASE_URL}
            data-supabase-key={SUPABASE_ANON_KEY}
        >
            <!-- Header Section -->
            <section class="mx-auto w-[calc(100%-1rem)] max-w-6xl">
                <div class="space-y-4">
                    <div class="flex items-center gap-2.5">
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--glass-border)] bg-paper px-3 py-1 text-xs font-bold uppercase tracking-wider text-accent dark:bg-paper-deep">
                            <span class="h-2 w-2 rounded-full bg-accent animate-pulse"></span>
                            AI Curation
                        </span>
                        <span class="text-xs text-ink/60 dark:text-gray">
                            已收录 <strong id="total-tools-counter" class="text-ink dark:text-gray-dark font-semibold">{presetTools.length}</strong> 款精选工具
                        </span>
                    </div>

                    <h1 class="text-3xl font-extrabold tracking-tight md:text-5xl">
                        AI 工具精选
                    </h1>
                    <p class="max-w-2xl text-base text-ink/75 dark:text-gray-dark/80 md:text-lg">
                        收录高生产力的 AI 辅助工具，分类导航与快速检索，助你在开发、设计、写作与研究中快人一步。
                    </p>
                </div>

                <!-- Search and Filter Controls -->
                <div class="mt-8 space-y-4 rounded-xl border border-[var(--glass-border)] bg-paper/60 p-4 shadow-sm backdrop-blur-sm dark:bg-paper-deep/50 md:p-6">
                    <!-- Search Input -->
                    <div class="relative">
                        <label for="search-input" class="sr-only">搜索 AI 工具</label>
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-ink/40 dark:text-gray/50">
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <input
                            type="text"
                            id="search-input"
                            autocomplete="off"
                            placeholder="搜索工具名称、功能简介、标签（例如：编程、React、绘图、Claude）..."
                            class="w-full rounded-lg border border-[var(--glass-border)] bg-paper py-2.5 pl-11 pr-10 text-sm text-ink placeholder-ink/40 transition focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 dark:bg-paper dark:text-gray-dark dark:placeholder-gray/40"
                        />
                        <button
                            id="clear-search"
                            type="button"
                            class="hidden absolute inset-y-0 right-0 items-center pr-3 text-ink/40 hover:text-ink dark:text-gray/50 dark:hover:text-gray-dark cursor-pointer"
                            aria-label="清除搜索条件"
                        >
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                            </svg>
                        </button>
                    </div>

                    <!-- Category Pills -->
                    <div class="flex flex-wrap items-center gap-2 pt-1" id="category-filters" role="tablist" aria-label="工具类别筛选">
                        {
                            TOOL_CATEGORIES.map((cat) => (
                                <button
                                    type="button"
                                    role="tab"
                                    aria-selected={cat === "全部" ? "true" : "false"}
                                    data-category={cat}
                                    class:list={[
                                        "category-pill inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs md:text-sm font-medium transition cursor-pointer select-none border",
                                        cat === "全部"
                                            ? "active-pill border-accent bg-accent text-white shadow-sm"
                                            : "border-[var(--glass-border)] bg-paper text-ink/80 hover:border-accent/60 hover:text-ink dark:bg-paper dark:text-gray-dark/80 dark:hover:text-black",
                                    ]}
                                >
                                    <span>{cat}</span>
                                    <span class="pill-count text-[11px] opacity-75">({categoryCounts[cat] || 0})</span>
                                </button>
                            ))
                        }
                    </div>
                </div>

                <!-- Results Summary Bar -->
                <div class="mt-4 flex items-center justify-between text-xs text-ink/60 dark:text-gray px-1">
                    <div>
                        正在展示: <span id="visible-count" class="font-bold text-accent">{presetTools.length}</span> 个工具
                    </div>
                </div>
            </section>

            <!-- Tools Grid Section -->
            <section class="mx-auto w-[calc(100%-1rem)] max-w-6xl">
                <div
                    id="tools-grid"
                    class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
                    role="region"
                    aria-label="AI 工具列表"
                >
                    {
                        presetTools.length === 0 &&
                            Array.from({ length: 6 }).map((_, idx) => (
                                <div
                                    class="loading-skeleton surface-card rounded-xl p-5 flex flex-col justify-between animate-pulse"
                                    aria-hidden="true"
                                    data-skeleton={idx}
                                >
                                    <div>
                                        <div class="flex items-center gap-3">
                                            <div class="h-11 w-11 shrink-0 rounded-lg bg-black/10 dark:bg-white/10" />
                                            <div class="flex-1 space-y-2">
                                                <div class="h-4 w-28 rounded bg-black/10 dark:bg-white/10" />
                                                <div class="h-3 w-16 rounded bg-black/5 dark:bg-white/5" />
                                            </div>
                                        </div>
                                        <div class="mt-4 space-y-2">
                                            <div class="h-3 w-full rounded bg-black/5 dark:bg-white/5" />
                                            <div class="h-3 w-4/5 rounded bg-black/5 dark:bg-white/5" />
                                        </div>
                                    </div>
                                    <div class="mt-5 pt-3 border-t border-[var(--glass-border)]/40 flex gap-2">
                                        <div class="h-4 w-12 rounded bg-black/5 dark:bg-white/5" />
                                        <div class="h-4 w-14 rounded bg-black/5 dark:bg-white/5" />
                                    </div>
                                </div>
                            ))
                    }
                    {
                        presetTools.map((tool) => (
                            <article
                                class="tool-card surface-card lift-card group relative flex flex-col justify-between overflow-hidden rounded-xl p-5"
                                data-id={tool.id}
                                data-category={tool.category}
                                data-title={tool.name.toLowerCase()}
                                data-description={tool.description.toLowerCase()}
                                data-tags={(tool.tags || []).join(" ").toLowerCase()}
                            >
                                <div>
                                    <!-- Top Row: Icon + Name + Category -->
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="flex items-center gap-3 min-w-0">
                                            <div class="relative flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-[var(--glass-border)] bg-white/70 p-1 shadow-sm dark:bg-black/20">
                                                <img
                                                    src={tool.icon}
                                                    alt={`${tool.name} 图标`}
                                                    width="44"
                                                    height="44"
                                                    loading="lazy"
                                                    class="h-full w-full object-contain"
                                                    onerror="this.onerror=null; this.src='/favicon.svg';"
                                                />
                                            </div>
                                            <div class="min-w-0">
                                                <h2 class="text-base font-bold text-ink truncate group-hover:text-accent-dark transition-colors dark:text-gray-dark">
                                                    {tool.name}
                                                </h2>
                                                <span class="inline-block mt-0.5 text-xs text-ink/50 dark:text-gray/60 font-medium">
                                                    {tool.category}
                                                </span>
                                            </div>
                                        </div>

                                        <!-- External link arrow -->
                                        <div class="shrink-0 text-ink/30 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent dark:text-gray/40">
                                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
                                            </svg>
                                        </div>
                                    </div>

                                    <!-- Description -->
                                    <p class="mt-3.5 text-sm text-ink/75 leading-relaxed dark:text-gray-dark/85 line-clamp-3">
                                        {tool.description}
                                    </p>
                                </div>

                                <!-- Bottom Row: Tags + Link overlay -->
                                <div class="mt-5 pt-3 border-t border-[var(--glass-border)]/60 flex items-center justify-between gap-2">
                                    <div class="flex flex-wrap items-center gap-1.5 min-w-0">
                                        {
                                            (tool.tags || []).slice(0, 3).map((tag) => (
                                                <span class="inline-block rounded px-2 py-0.5 text-[11px] font-medium bg-black/5 text-ink/70 dark:bg-white/5 dark:text-gray/90 truncate max-w-[120px]">
                                                    #{tag}
                                                </span>
                                            ))
                                        }
                                    </div>
                                    <span class="shrink-0 text-xs font-semibold text-accent group-hover:underline">
                                        访问
                                    </span>
                                </div>

                                <!-- Full card clickable link -->
                                <a
                                    href={tool.url}
                                    target="_blank"
                                    rel="noreferrer"
                                    class="absolute inset-0 z-10"
                                    aria-label={`访问 ${tool.name} 官网`}
                                >
                                    <span class="sr-only">访问 {tool.name}</span>
                                </a>
                            </article>
                        ))
                    }
                </div>

                <!-- Empty State -->
                <div
                    id="empty-state"
                    class="hidden my-12 flex flex-col items-center justify-center rounded-2xl border border-dashed border-[var(--glass-border)] p-12 text-center"
                >
                    <div class="flex h-16 w-16 items-center justify-center rounded-full bg-accent/10 text-accent mb-4">
                        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-ink dark:text-gray-dark">未找到匹配的 AI 工具</h3>
                    <p class="mt-2 text-sm text-ink/60 dark:text-gray max-w-sm">
                        尝试更换关键词，或切换至「全部」分类查看更多工具。
                    </p>
                    <button
                        id="reset-filters-btn"
                        type="button"
                        class="mt-5 inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-accent-dark cursor-pointer"
                    >
                        重置所有筛选
                    </button>
                </div>
            </section>
        </main>

        <Footer />

        <!-- Client-side Public Script: Search, Filter & Cloud Sync -->
        <script>
            import { fetchCloudTools, TOOLS_CACHE_KEY, type ToolItem } from "../../lib/supabase";
            import { escapeHtml, sanitizeUrl } from "../../lib/utils";

            function mergePresetAndCloud(presets: ToolItem[], cloudItems: ToolItem[]): ToolItem[] {
                const merged = [...presets];
                cloudItems.forEach((item) => {
                    const existingIdx = merged.findIndex((t) => t.id === item.id || t.url === item.url);
                    if (existingIdx >= 0) {
                        merged[existingIdx] = item;
                    } else {
                        merged.push(item);
                    }
                });
                return merged;
            }

            function initVisitorTools() {
                const container = document.getElementById("tools-page-container");
                const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
                const clearSearchBtn = document.getElementById("clear-search");
                const categoryPills = document.querySelectorAll<HTMLButtonElement>(".category-pill");
                const toolsGrid = document.getElementById("tools-grid");
                const emptyState = document.getElementById("empty-state");
                const visibleCountSpan = document.getElementById("visible-count");
                const totalCounterSpan = document.getElementById("total-tools-counter");
                const resetBtn = document.getElementById("reset-filters-btn");

                if (!toolsGrid || toolsGrid.hasAttribute("data-tools-init")) return;
                toolsGrid.setAttribute("data-tools-init", "true");

                let activeCategory = "全部";
                let searchQuery = "";
                const presetTools: ToolItem[] = [];
                let allTools: ToolItem[] = [];

                // 1. Collect preset tools from SSR DOM
                const existingCards = document.querySelectorAll<HTMLElement>(".tool-card");
                existingCards.forEach((card) => {
                    const id = card.getAttribute("data-id") || "";
                    const name = card.querySelector("h2")?.textContent?.trim() || "";
                    const category = card.getAttribute("data-category") || "";
                    const description = card.querySelector("p")?.textContent?.trim() || "";
                    const link = card.querySelector<HTMLAnchorElement>("a")?.href || "";
                    const icon = card.querySelector<HTMLImageElement>("img")?.src || "";
                    const tagsStr = card.getAttribute("data-tags") || "";
                    const tags = tagsStr.split(" ").filter(Boolean);

                    presetTools.push({
                        id,
                        name,
                        url: link,
                        icon,
                        category,
                        description,
                        tags
                    });
                });

                allTools = [...presetTools];

                function renderCards() {
                    if (!toolsGrid) return;
                    toolsGrid.innerHTML = "";

                    allTools.forEach((tool) => {
                        const safeName = escapeHtml(tool.name);
                        const safeCategory = escapeHtml(tool.category);
                        const safeDesc = escapeHtml(tool.description);
                        const safeUrl = escapeHtml(sanitizeUrl(tool.url));
                        const safeIcon = escapeHtml(sanitizeUrl(tool.icon, "/favicon.svg"));

                        const article = document.createElement("article");
                        article.className = "tool-card surface-card lift-card group relative flex flex-col justify-between overflow-hidden rounded-xl p-5";
                        article.setAttribute("data-id", tool.id);
                        article.setAttribute("data-category", tool.category);
                        article.setAttribute("data-title", tool.name.toLowerCase());
                        article.setAttribute("data-description", tool.description.toLowerCase());
                        article.setAttribute("data-tags", (tool.tags || []).join(" ").toLowerCase());

                        const tagsHtml = (tool.tags || [])
                            .slice(0, 3)
                            .map((tag) => {
                                const safeTag = escapeHtml(tag);
                                return `<span class="inline-block rounded px-2 py-0.5 text-[11px] font-medium bg-black/5 text-ink/70 dark:bg-white/5 dark:text-gray/90 truncate max-w-[120px]">#${safeTag}</span>`;
                            })
                            .join("");

                        article.innerHTML = `
                            <div>
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <div class="relative flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-[var(--glass-border)] bg-white/70 p-1 shadow-sm dark:bg-black/20">
                                            <img
                                                src="${safeIcon}"
                                                alt="${safeName} 图标"
                                                width="44"
                                                height="44"
                                                loading="lazy"
                                                class="h-full w-full object-contain"
                                                onerror="this.onerror=null; this.src='/favicon.svg';"
                                            />
                                        </div>
                                        <div class="min-w-0">
                                            <h2 class="text-base font-bold text-ink truncate group-hover:text-accent-dark transition-colors dark:text-gray-dark">
                                                ${safeName}
                                            </h2>
                                            <span class="inline-block mt-0.5 text-xs text-ink/50 dark:text-gray/60 font-medium">
                                                ${safeCategory}
                                            </span>
                                        </div>
                                    </div>
                                    <div class="shrink-0 text-ink/30 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent dark:text-gray/40">
                                        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
                                        </svg>
                                    </div>
                                </div>
                                <p class="mt-3.5 text-sm text-ink/75 leading-relaxed dark:text-gray-dark/85 line-clamp-3">
                                    ${safeDesc}
                                </p>
                            </div>
                            <div class="mt-5 pt-3 border-t border-[var(--glass-border)]/60 flex items-center justify-between gap-2">
                                <div class="flex flex-wrap items-center gap-1.5 min-w-0">
                                    ${tagsHtml}
                                </div>
                                <span class="shrink-0 text-xs font-semibold text-accent group-hover:underline">
                                    访问
                                </span>
                            </div>
                            <a
                                href="${safeUrl}"
                                target="_blank"
                                rel="noreferrer"
                                class="absolute inset-0 z-10"
                                aria-label="访问 ${safeName} 官网"
                            >
                                <span class="sr-only">访问 ${safeName}</span>
                            </a>
                        `;
                        toolsGrid.appendChild(article);
                    });

                    updateCounts();
                    filterTools();
                }

                function updateCounts() {
                    const counts: Record<string, number> = { 全部: allTools.length };
                    allTools.forEach((t) => {
                        counts[t.category] = (counts[t.category] || 0) + 1;
                    });

                    if (totalCounterSpan) {
                        totalCounterSpan.textContent = String(allTools.length);
                    }

                    categoryPills.forEach((pill) => {
                        const cat = pill.getAttribute("data-category") || "";
                        const countSpan = pill.querySelector(".pill-count");
                        if (countSpan) {
                            countSpan.textContent = `(${counts[cat] || 0})`;
                        }
                    });
                }

                function filterTools() {
                    const cards = document.querySelectorAll<HTMLElement>(".tool-card");
                    let visibleCount = 0;
                    const query = searchQuery.trim().toLowerCase();

                    cards.forEach((card) => {
                        const cardCategory = card.getAttribute("data-category") || "";
                        const cardTitle = card.getAttribute("data-title") || "";
                        const cardDesc = card.getAttribute("data-description") || "";
                        const cardTags = card.getAttribute("data-tags") || "";

                        const matchesCategory =
                            activeCategory === "全部" || cardCategory === activeCategory;

                        const matchesSearch =
                            !query ||
                            cardTitle.includes(query) ||
                            cardDesc.includes(query) ||
                            cardTags.includes(query);

                        if (matchesCategory && matchesSearch) {
                            card.style.display = "";
                            visibleCount++;
                        } else {
                            card.style.display = "none";
                        }
                    });

                    if (visibleCountSpan) {
                        visibleCountSpan.textContent = String(visibleCount);
                    }

                    if (emptyState && toolsGrid) {
                        if (visibleCount === 0) {
                            emptyState.classList.remove("hidden");
                            emptyState.classList.add("flex");
                            toolsGrid.classList.add("hidden");
                        } else {
                            emptyState.classList.add("hidden");
                            emptyState.classList.remove("flex");
                            toolsGrid.classList.remove("hidden");
                        }
                    }

                    if (clearSearchBtn) {
                        if (query.length > 0) {
                            clearSearchBtn.classList.remove("hidden");
                            clearSearchBtn.classList.add("flex");
                        } else {
                            clearSearchBtn.classList.add("hidden");
                            clearSearchBtn.classList.remove("flex");
                        }
                    }

                    categoryPills.forEach((pill) => {
                        const cat = pill.getAttribute("data-category");
                        if (cat === activeCategory) {
                            pill.setAttribute("aria-selected", "true");
                            pill.classList.add("active-pill", "border-accent", "bg-accent", "text-white", "shadow-sm");
                            pill.classList.remove("bg-paper", "text-ink/80", "dark:bg-paper", "dark:text-gray-dark/80");
                        } else {
                            pill.setAttribute("aria-selected", "false");
                            pill.classList.remove("active-pill", "border-accent", "bg-accent", "text-white", "shadow-sm");
                            pill.classList.add("bg-paper", "text-ink/80", "dark:bg-paper", "dark:text-gray-dark/80");
                        }
                    });
                }

                // 2. SWR Cache + Fetch remote tools from Supabase
                async function syncCloudTools() {
                    let renderedFromCache = false;
                    try {
                        const cachedRaw = localStorage.getItem(TOOLS_CACHE_KEY);
                        if (cachedRaw) {
                            const cachedItems = JSON.parse(cachedRaw) as ToolItem[];
                            if (Array.isArray(cachedItems) && cachedItems.length > 0) {
                                allTools = mergePresetAndCloud(presetTools, cachedItems);
                                renderCards();
                                renderedFromCache = true;
                            }
                        }
                    } catch {
                        // Ignore cache errors
                    }

                    let supabaseUrl = container?.getAttribute("data-supabase-url") || "";
                    let supabaseKey = container?.getAttribute("data-supabase-key") || "";

                    if (!supabaseUrl || !supabaseKey) {
                        try {
                            const localCfg = localStorage.getItem("bytemvp_supabase_config");
                            if (localCfg) {
                                const parsed = JSON.parse(localCfg);
                                supabaseUrl = parsed.url;
                                supabaseKey = parsed.key;
                            }
                        } catch {
                            // Ignore local config error
                        }
                    }

                    if (!supabaseUrl || !supabaseKey) {
                        if (!renderedFromCache) renderCards();
                        return;
                    }

                    try {
                        const cloudItems = await fetchCloudTools(supabaseUrl, supabaseKey);
                        const nextTools = mergePresetAndCloud(presetTools, cloudItems);
                        const prevSnapshot = JSON.stringify(allTools);
                        const nextSnapshot = JSON.stringify(nextTools);

                        try {
                            localStorage.setItem(TOOLS_CACHE_KEY, JSON.stringify(cloudItems));
                        } catch {
                            // Ignore quota errors
                        }

                        if (!renderedFromCache || prevSnapshot !== nextSnapshot) {
                            allTools = nextTools;
                            renderCards();
                        }
                    } catch (e) {
                        console.warn("Public cloud sync silent notice:", e);
                        if (!renderedFromCache) {
                            renderCards();
                        }
                    }
                }

                // Search & Filter event listeners
                searchInput?.addEventListener("input", (e) => {
                    searchQuery = (e.target as HTMLInputElement).value;
                    filterTools();
                });

                searchInput?.addEventListener("keydown", (e) => {
                    if (e.key === "Escape") {
                        searchQuery = "";
                        searchInput.value = "";
                        filterTools();
                        searchInput.blur();
                    }
                });

                clearSearchBtn?.addEventListener("click", () => {
                    searchQuery = "";
                    if (searchInput) searchInput.value = "";
                    filterTools();
                    searchInput?.focus();
                });

                categoryPills.forEach((pill) => {
                    pill.addEventListener("click", () => {
                        const selected = pill.getAttribute("data-category");
                        if (selected) {
                            activeCategory = selected;
                            filterTools();
                        }
                    });
                });

                resetBtn?.addEventListener("click", () => {
                    activeCategory = "全部";
                    searchQuery = "";
                    if (searchInput) searchInput.value = "";
                    filterTools();
                    searchInput?.focus();
                });

                // Guard global "/" shortcut so it never binds multiple times across View Transitions
                if (!(window as unknown as { __toolsShortcutBound?: boolean }).__toolsShortcutBound) {
                    (window as unknown as { __toolsShortcutBound?: boolean }).__toolsShortcutBound = true;
                    window.addEventListener("keydown", (e) => {
                        const activeSearchInput = document.getElementById("search-input") as HTMLInputElement | null;
                        if (activeSearchInput && e.key === "/" && document.activeElement !== activeSearchInput) {
                            e.preventDefault();
                            activeSearchInput.focus();
                        }
                    });
                }

                syncCloudTools();
            }

            document.addEventListener("astro:page-load", initVisitorTools);
        </script>
    </body>
</html>
