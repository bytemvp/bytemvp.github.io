---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const cardColors = ["bg-candy", "bg-aqua", "bg-lime", "bg-mango", "bg-bubble"];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} image={posts[0]?.data.heroImage} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-6xl px-4 py-10 md:py-16">
			<section class="mb-10 grid gap-6 rounded-3xl border border-ink/15 bg-white/88 p-6 shadow-soft dark:bg-gray-light md:grid-cols-[1fr_auto] md:items-end md:p-8">
				<div class="max-w-3xl">
					<p class="mb-3 inline-flex rounded-full bg-lime px-4 py-2 text-sm font-bold uppercase text-ink dark:text-gray-dark">
						AI 资讯
					</p>
					<h1 class="text-ink dark:text-gray-dark">聚合近期 AI 动态与实践观察。</h1>
					<p class="mt-4 text-xl font-semibold text-gray-dark dark:text-gray">
						收集模型发布、产品更新、产业动作和 AI 工作流趋势，方便快速了解关键变化。
					</p>
				</div>
				<div class="rounded-2xl border border-ink/15 bg-mango p-5 text-center text-ink shadow-pop dark:text-gray-dark">
					<p class="text-5xl font-bold leading-none">{posts.length}</p>
					<p class="font-bold uppercase">篇资讯</p>
				</div>
			</section>

			<section>
				<ul class="grid gap-6 lg:grid-cols-2">
					{
						posts.map((post, index) => (
							<li class:list={[index === 0 ? "lg:col-span-2" : ""]}>
								<a
									class:list={[
										"group grid h-full overflow-hidden rounded-3xl border border-ink/15 bg-white/90 shadow-pop transition-transform hover:-translate-y-1 dark:bg-gray-light",
										index === 0 ? "lg:grid-cols-[0.95fr_1.05fr]" : "",
									]}
									href={`/blog/${post.id}/`}
								>
									<img
										class:list={[
											"aspect-[16/9] w-full object-cover",
											index === 0 ? "h-auto lg:h-full lg:min-h-80" : "h-auto",
										]}
										width={900}
										height={520}
										src={post.data.heroImage}
										alt=""
									/>
									<div class:list={[
										"flex flex-col justify-between gap-6 p-6",
										cardColors[index % cardColors.length],
										"text-ink dark:text-gray-dark",
									]}>
										<div class="space-y-4">
											<p class="inline-flex rounded-full bg-white/85 px-3 py-1 text-sm font-bold text-[#142326] dark:bg-white/10 dark:text-gray-dark">
												<FormattedDate date={post.data.pubDate} />
											</p>
											<h2 class={index === 0 ? "text-3xl leading-tight md:text-4xl" : "text-2xl leading-tight md:text-3xl"}>
												{post.data.title}
											</h2>
											<p class="text-base font-semibold md:text-lg">{post.data.description}</p>
											{
												post.data.tags.length > 0 && (
													<div class="flex flex-wrap gap-2">
														{post.data.tags.map((tag) => (
															<span class="rounded-full bg-white/85 px-3 py-1 text-xs font-bold text-[#142326] dark:bg-white/10 dark:text-gray-dark">#{tag}</span>
														))}
													</div>
												)
											}
										</div>
										<span class="font-bold underline decoration-[3px] underline-offset-4">
											打开文章
										</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
