---
import BaseHead from "../../components/BaseHead.astro";
import {
    SITE_TITLE,
    SUPABASE_URL,
    SUPABASE_ANON_KEY,
    TOOL_CATEGORIES,
    MANAGE_CATEGORIES,
} from "../../consts";
import toolsData from "../../data/tools.json";

const presetTools = toolsData;
const pageTitle = `AI 工具后台管理 · ${SITE_TITLE}`;
const pageDescription = "Byte MVP AI 工具后台管理控制台";
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title={pageTitle} description={pageDescription} />
        <!-- Disallow indexing on the admin page -->
        <meta name="robots" content="noindex, nofollow" />
    </head>
    <body class="min-h-screen bg-paper text-ink dark:bg-paper dark:text-gray-dark flex flex-col font-sans">
        <!-- Preset Tools Data for offline/static loading -->
        <script id="preset-tools-data" type="application/json" set:html={JSON.stringify(presetTools)}></script>

        <!-- ==================== 1. SUPABASE AUTH LOGIN SCREEN ==================== -->
        <div id="auth-gate-screen" class="flex flex-1 items-center justify-center p-4">
            <div class="w-full max-w-sm rounded-2xl border border-[var(--glass-border)] bg-paper/85 p-8 shadow-2xl backdrop-blur-md dark:bg-paper-deep text-center">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/15 text-accent mb-4 shadow-sm">
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                </div>

                <h1 class="text-xl font-extrabold tracking-tight text-ink dark:text-gray-dark">
                    管理员安全登录
                </h1>
                <p class="mt-1 text-xs text-ink/60 dark:text-gray">
                    基于 Supabase Auth 官方身份鉴权，保护云端数据库安全
                </p>

                <form id="login-form" class="mt-6 space-y-3.5 text-left">
                    <div>
                        <label for="admin-email" class="block text-xs font-semibold text-ink/70 dark:text-gray/80 mb-1">
                            管理员邮箱
                        </label>
                        <input
                            type="email"
                            id="admin-email"
                            required
                            autofocus
                            placeholder="例如: your_email@gmail.com"
                            class="w-full rounded-xl border border-[var(--glass-border)] bg-paper px-3.5 py-2.5 text-sm text-ink placeholder-ink/40 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 dark:bg-paper dark:text-gray-dark"
                        />
                    </div>

                    <div>
                        <label for="admin-password" class="block text-xs font-semibold text-ink/70 dark:text-gray/80 mb-1">
                            登录密码
                        </label>
                        <input
                            type="password"
                            id="admin-password"
                            required
                            placeholder="输入 Supabase 管理员密码"
                            class="w-full rounded-xl border border-[var(--glass-border)] bg-paper px-3.5 py-2.5 text-sm text-ink placeholder-ink/40 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 dark:bg-paper dark:text-gray-dark"
                        />
                    </div>

                    <div class="flex items-center gap-2 pt-1 text-xs text-ink/70 dark:text-gray">
                        <input type="checkbox" id="remember-login-check" checked class="rounded border-[var(--glass-border)] text-accent focus:ring-accent" />
                        <label for="remember-login-check">在此浏览器记住登录状态</label>
                    </div>

                    <button
                        type="submit"
                        id="login-submit-btn"
                        class="w-full mt-2 rounded-xl bg-accent py-2.5 text-sm font-bold text-white shadow-md transition hover:bg-accent-dark cursor-pointer active:scale-95"
                    >
                        安全登录并进入后台
                    </button>

                    <div class="pt-3 border-t border-[var(--glass-border)]/60 text-center">
                        <p class="text-[11px] text-ink/50 dark:text-gray/60 leading-normal">
                            💡 提示：请确保已在 Supabase 后台的 <strong>Authentication → Users</strong> 中添加了该管理员账号。
                        </p>
                    </div>
                </form>
            </div>
        </div>

        <!-- ==================== 2. MAIN ADMIN DASHBOARD ==================== -->
        <div
            id="admin-dashboard-screen"
            class="hidden flex-1 flex-col"
            data-supabase-url={SUPABASE_URL}
            data-supabase-key={SUPABASE_ANON_KEY}
        >
            <!-- Admin Top Navigation Bar -->
            <header class="sticky top-0 z-40 border-b border-[var(--glass-border)] bg-paper/90 backdrop-blur-md dark:bg-paper/90">
                <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
                    <div class="flex items-center gap-3">
                        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent text-white font-bold text-sm">
                            B
                        </span>
                        <div>
                            <h2 class="text-base font-bold text-ink dark:text-gray-dark flex items-center gap-2">
                                <span>AI 工具后台管理</span>
                                <span class="rounded bg-accent/15 px-2 py-0.5 text-[11px] font-semibold text-accent">Admin Console</span>
                            </h2>
                        </div>
                    </div>

                    <div class="flex items-center gap-2.5 sm:gap-3 text-xs font-medium">
                        <span id="admin-user-badge" class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-[var(--glass-border)] bg-paper px-3 py-1 text-ink/70 dark:bg-paper-deep dark:text-gray">
                            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                            <span id="admin-user-email">管理员</span>
                        </span>

                        <a
                            href="/tools"
                            target="_blank"
                            class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--glass-border)] bg-paper px-3 py-1.5 text-ink hover:border-accent hover:text-accent-dark dark:bg-paper-deep dark:text-gray-dark"
                        >
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                            <span>预览前台 (/tools)</span>
                        </a>

                        <button
                            id="open-sql-guide-btn"
                            type="button"
                            class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--glass-border)] bg-paper px-3 py-1.5 text-ink hover:border-accent hover:text-accent-dark dark:bg-paper-deep dark:text-gray-dark cursor-pointer"
                        >
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                            <span>RLS 安全策略</span>
                        </button>

                        <button
                            id="logout-btn"
                            type="button"
                            class="inline-flex items-center gap-1 rounded-lg bg-red-500/10 px-3 py-1.5 text-red-600 hover:bg-red-500 hover:text-white transition cursor-pointer"
                        >
                            <span>退出登录</span>
                        </button>
                    </div>
                </div>
            </header>

            <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 space-y-8">
                <!-- Status & Metrics Cards -->
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                    <div class="surface-card rounded-xl p-5 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase text-ink/50 dark:text-gray/60">收录工具总数</p>
                            <h3 id="stat-total-count" class="mt-1 text-2xl font-bold text-accent">0</h3>
                        </div>
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent/10 text-accent">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                            </svg>
                        </div>
                    </div>

                    <div class="surface-card rounded-xl p-5 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase text-ink/50 dark:text-gray/60">云端实时工具</p>
                            <h3 id="stat-cloud-count" class="mt-1 text-2xl font-bold text-emerald-600">0</h3>
                        </div>
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-600">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" />
                            </svg>
                        </div>
                    </div>

                    <div class="surface-card rounded-xl p-5 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase text-ink/50 dark:text-gray/60">安全鉴权状态</p>
                            <p class="mt-1 text-sm font-bold text-emerald-600 flex items-center gap-1.5">
                                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span>已通过 Auth 管理员认证</span>
                            </p>
                        </div>
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-600">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- SECTION 1: Quick Add Tool Form (顶部快捷录入) -->
                <section class="surface-card rounded-2xl p-6 shadow-sm">
                    <div class="flex items-center gap-2 pb-4 border-b border-[var(--glass-border)]">
                        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-accent text-white text-xs font-bold">
                            +
                        </span>
                        <div>
                            <h3 class="text-base font-bold text-ink dark:text-gray-dark">快捷录入新工具</h3>
                            <p class="text-xs text-ink/60 dark:text-gray">填写工具网址，自动抓取图标、名称、简介，通过管理员权限直接保存到 Supabase</p>
                        </div>
                    </div>

                    <form id="quick-add-form" class="mt-5 space-y-4">
                        <!-- URL + Scrape Action -->
                        <div>
                            <label for="new-tool-url" class="block text-xs font-semibold uppercase text-ink/70 dark:text-gray/80 mb-1.5">
                                工具官方网址 (URL) <span class="text-red-500">*</span>
                            </label>
                            <div class="flex gap-2">
                                <input
                                    type="url"
                                    id="new-tool-url"
                                    required
                                    placeholder="例如: https://cursor.com 或 https://claude.ai"
                                    class="flex-1 rounded-xl border border-[var(--glass-border)] bg-paper px-4 py-2.5 text-sm text-ink placeholder-ink/40 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 dark:bg-paper dark:text-gray-dark"
                                />
                                <button
                                    type="button"
                                    id="scrape-btn"
                                    class="inline-flex items-center gap-1.5 rounded-xl bg-accent/15 px-4 py-2.5 text-xs font-bold text-accent transition hover:bg-accent hover:text-white cursor-pointer shrink-0 active:scale-95"
                                >
                                    <svg id="scrape-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                    </svg>
                                    <span id="scrape-btn-text">自动抓取信息</span>
                                </button>
                            </div>
                        </div>

                        <!-- Name, Category, Icon row -->
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-12">
                            <!-- Icon preview -->
                            <div class="sm:col-span-2 flex flex-col items-center justify-center">
                                <label class="block text-xs font-semibold uppercase text-ink/70 dark:text-gray/80 mb-1">图标预览</label>
                                <div class="relative flex h-12 w-12 items-center justify-center rounded-xl border border-[var(--glass-border)] bg-white/70 p-1 shadow-sm dark:bg-black/20">
                                    <img
                                        id="new-tool-icon-preview"
                                        src="/favicon.svg"
                                        alt="图标"
                                        class="h-full w-full object-contain"
                                        onerror="this.onerror=null; this.src='/favicon.svg';"
                                    />
                                </div>
                                <input type="hidden" id="new-tool-icon" value="/favicon.svg" />
                                <label class="mt-1.5 cursor-pointer text-[10px] text-accent hover:underline flex items-center gap-0.5" title="从电脑选择图片上传至 Supabase 存储桶">
                                    <span>📁 本地上传</span>
                                    <input type="file" id="new-tool-icon-file" accept="image/*,.svg,.ico" class="hidden" />
                                </label>
                            </div>

                            <!-- Name -->
                            <div class="sm:col-span-6">
                                <label for="new-tool-name" class="block text-xs font-semibold uppercase text-ink/70 dark:text-gray/80 mb-1.5">
                                    工具名称 <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="text"
                                    id="new-tool-name"
                                    required
                                    placeholder="例如: Cursor"
                                    class="w-full rounded-xl border border-[var(--glass-border)] bg-paper px-3.5 py-2 text-sm text-ink placeholder-ink/40 focus:border-accent focus:outline-none dark:bg-paper dark:text-gray-dark"
                                />
                            </div>

                            <!-- Category -->
                            <div class="sm:col-span-4">
                                <label for="new-tool-category" class="block text-xs font-semibold uppercase text-ink/70 dark:text-gray/80 mb-1.5">
                                    归属分类 <span class="text-red-500">*</span>
                                </label>
                                <select
                                    id="new-tool-category"
                                    class="w-full rounded-xl border border-[var(--glass-border)] bg-paper px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none dark:bg-paper dark:text-gray-dark"
                                >
                                    {MANAGE_CATEGORIES.map((cat) => (
                                        <option value={cat}>{cat}</option>
                                    ))}
                                </select>
                            </div>
                        </div>

                        <!-- Description -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <label for="new-tool-desc" class="block text-xs font-semibold uppercase text-ink/70 dark:text-gray/80">
                                    工具功能简介 (中文) <span class="text-red-500">*</span>
                                </label>
                                <button
                                    type="button"
                                    id="translate-add-desc-btn"
                                    class="inline-flex items-center gap-1 text-[11px] font-semibold text-accent hover:text-accent-dark hover:underline cursor-pointer"
                                    title="将当前简介一键翻译为中文"
                                >
                                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                                    </svg>
                                    <span id="translate-add-btn-text">一键翻译为中文</span>
                                </button>
                            </div>
                            <textarea
                                id="new-tool-desc"
                                rows="2"
                                required
                                placeholder="输入或抓取中文功能简介（若抓取到英文将自动翻译为地道中文）..."
                                class="w-full rounded-xl border border-[var(--glass-border)] bg-paper px-3.5 py-2 text-sm text-ink placeholder-ink/40 focus:border-accent focus:outline-none dark:bg-paper dark:text-gray-dark"
                            ></textarea>
                        </div>

                        <!-- Tags + Submit -->
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-2">
                            <div class="flex-1">
                                <label for="new-tool-tags" class="sr-only">标签</label>
                                <input
                                    type="text"
                                    id="new-tool-tags"
                                    placeholder="标签（逗号隔开，例如：代码补全, AI Agent, VS Code）"
                                    class="w-full rounded-xl border border-[var(--glass-border)] bg-paper px-3.5 py-2 text-xs text-ink placeholder-ink/40 focus:border-accent focus:outline-none dark:bg-paper dark:text-gray-dark"
                                />
                            </div>

                            <button
                                type="submit"
                                id="submit-btn"
                                class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-2.5 text-sm font-bold text-white shadow-md transition hover:bg-accent-dark cursor-pointer shrink-0 active:scale-95"
                            >
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                </svg>
                                <span id="submit-btn-text">立即发布至云端</span>
                            </button>
                        </div>
                    </form>
                </section>

                <!-- SECTION 2: Tools Management Table (下方工具管理表格) -->
                <section class="surface-card rounded-2xl p-6 shadow-sm">
                    <!-- Table Header Controls: Search & Category Filter -->
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-5 border-b border-[var(--glass-border)]">
                        <div>
                            <h3 class="text-base font-bold text-ink dark:text-gray-dark flex items-center gap-2">
                                <span>已收录工具列表</span>
                                <span class="rounded bg-accent/15 px-2 py-0.5 text-[11px] font-semibold text-accent">支持拖拽排序</span>
                            </h3>
                            <p class="text-xs text-ink/60 dark:text-gray">按住左侧 ⠿ 图标即可上下拖拽调整顺序，实时持久化保存到数据库</p>
                        </div>

                        <div class="flex flex-wrap items-center gap-3">
                            <button
                                type="button"
                                id="sync-icons-btn"
                                class="inline-flex items-center gap-1.5 rounded-lg bg-sky-500/10 border border-sky-500/25 px-3 py-1.5 text-xs font-semibold text-sky-600 hover:bg-sky-500 hover:text-white transition cursor-pointer active:scale-95"
                                title="一键将外部第三方图标转存至 Supabase 存储桶，通过 CDN 高速访问"
                            >
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                </svg>
                                <span id="sync-icons-btn-text">☁️ 转存图标至 Supabase</span>
                            </button>

                            <button
                                type="button"
                                id="save-order-btn"
                                class="hidden inline-flex items-center gap-1.5 rounded-lg bg-emerald-600/15 border border-emerald-500/30 px-3 py-1.5 text-xs font-semibold text-emerald-600 hover:bg-emerald-600 hover:text-white transition cursor-pointer"
                                title="手动保存当前排序"
                            >
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span id="save-order-text">保存排序</span>
                            </button>

                            <select
                                id="table-filter-category"
                                class="rounded-lg border border-[var(--glass-border)] bg-paper px-3 py-1.5 text-xs text-ink focus:border-accent focus:outline-none dark:bg-paper dark:text-gray-dark"
                            >
                                {TOOL_CATEGORIES.map((cat) => (
                                    <option value={cat}>{cat === "全部" ? "全部类别" : cat}</option>
                                ))}
                            </select>

                            <input
                                type="text"
                                id="table-search-input"
                                placeholder="搜索名称或描述..."
                                class="rounded-lg border border-[var(--glass-border)] bg-paper px-3 py-1.5 text-xs text-ink placeholder-ink/40 focus:border-accent focus:outline-none dark:bg-paper dark:text-gray-dark w-44"
                            />
                        </div>
                    </div>

                    <!-- Responsive Table -->
                    <div class="overflow-x-auto mt-4">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="border-b border-[var(--glass-border)] text-ink/60 dark:text-gray/70">
                                    <th class="py-3 px-2 font-semibold w-16 text-center">排序</th>
                                    <th class="py-3 px-3 font-semibold">工具</th>
                                    <th class="py-3 px-3 font-semibold">分类</th>
                                    <th class="py-3 px-3 font-semibold max-w-xs">功能简介</th>
                                    <th class="py-3 px-3 font-semibold">来源</th>
                                    <th class="py-3 px-3 font-semibold text-right">操作</th>
                                </tr>
                            </thead>
                            <tbody id="tools-table-body" class="divide-y divide-[var(--glass-border)]/50">
                                <!-- Populated dynamically by JS -->
                            </tbody>
                        </table>
                    </div>
                </section>
            </main>
        </div>

        <!-- ==================== 3. EDIT MODAL ==================== -->
