        <!-- Global Toast Container -->
        <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

        <!-- ==================== CLIENT JAVASCRIPT ==================== -->
        <script>
            import {
                fetchCloudTools,
                isCdnIcon,
                type SupabaseSession,
                type ToolItem,
            } from "../../lib/supabase";
            import {
                authFetch,
                clearTokenRefreshTimer,
                deleteIconFromSupabaseStorage,
                getSavedSession,
                refreshSession,
                saveSession,
                scheduleTokenRefresh,
                transferIconToSupabase,
                uploadBlobToSupabaseStorage,
            } from "../../lib/admin-client";
            import {
                cleanToolTitle,
                containsChinese,
                escapeHtml,
                sanitizeUrl,
                translateToChinese,
            } from "../../lib/utils";

            const RLS_SQL_CODE = `alter table public.ai_tools add column if not exists sort_order integer default 0;
alter table public.ai_tools enable row level security;
drop policy if exists "Allow public read" on public.ai_tools;
create policy "Allow public read" on public.ai_tools for select using (true);

drop policy if exists "Allow public insert" on public.ai_tools;
drop policy if exists "Only admin insert" on public.ai_tools;
create policy "Only admin insert" on public.ai_tools for insert with check (auth.role() = 'authenticated');

drop policy if exists "Allow public update" on public.ai_tools;
drop policy if exists "Only admin update" on public.ai_tools;
create policy "Only admin update" on public.ai_tools for update using (auth.role() = 'authenticated') with check (auth.role() = 'authenticated');

drop policy if exists "Allow public delete" on public.ai_tools;
drop policy if exists "Only admin delete" on public.ai_tools;
create policy "Only admin delete" on public.ai_tools for delete using (auth.role() = 'authenticated');

insert into storage.buckets (id, name, public)
values ('tool-icons', 'tool-icons', true)
on conflict (id) do update set public = true;

drop policy if exists "Allow public read tool-icons" on storage.objects;
create policy "Allow public read tool-icons" on storage.objects for select using (bucket_id = 'tool-icons');

drop policy if exists "Allow admin insert tool-icons" on storage.objects;
create policy "Allow admin insert tool-icons" on storage.objects for insert with check (bucket_id = 'tool-icons' and auth.role() = 'authenticated');

drop policy if exists "Allow admin update tool-icons" on storage.objects;
create policy "Allow admin update tool-icons" on storage.objects for update using (bucket_id = 'tool-icons' and auth.role() = 'authenticated') with check (bucket_id = 'tool-icons' and auth.role() = 'authenticated');

drop policy if exists "Allow admin delete tool-icons" on storage.objects;
create policy "Allow admin delete tool-icons" on storage.objects for delete using (bucket_id = 'tool-icons' and auth.role() = 'authenticated');`;

            function showToast(message: string, type: "success" | "error" | "info" = "info") {
                const container = document.getElementById("toast-container");
                if (!container) return;
                const toast = document.createElement("div");
                toast.className = `pointer-events-auto flex items-center gap-2 rounded-xl border border-[var(--glass-border)] bg-paper px-4 py-3 text-sm shadow-xl transition-all duration-300 dark:bg-paper-deep text-ink dark:text-gray-dark`;

                const dot = document.createElement("span");
                dot.className =
                    type === "error"
                        ? "h-2 w-2 rounded-full bg-red-500 shrink-0"
                        : type === "success"
                        ? "h-2 w-2 rounded-full bg-emerald-500 shrink-0"
                        : "h-2 w-2 rounded-full bg-accent shrink-0";

                const textSpan = document.createElement("span");
                textSpan.textContent = message;

                toast.appendChild(dot);
                toast.appendChild(textSpan);
                container.appendChild(toast);
                setTimeout(() => {
                    toast.style.opacity = "0";
                    setTimeout(() => toast.remove(), 300);
                }, 3500);
            }

            function initAdmin() {
                const dashboard = document.getElementById("admin-dashboard-screen");
                const gateScreen = document.getElementById("auth-gate-screen");
                if (!dashboard || dashboard.hasAttribute("data-admin-init")) return;
                dashboard.setAttribute("data-admin-init", "true");
                const loginForm = document.getElementById("login-form") as HTMLFormElement | null;
                const emailInput = document.getElementById("admin-email") as HTMLInputElement | null;
                const passInput = document.getElementById("admin-password") as HTMLInputElement | null;
                const rememberLoginCheck = document.getElementById("remember-login-check") as HTMLInputElement | null;
                const loginSubmitBtn = document.getElementById("login-submit-btn") as HTMLButtonElement | null;
                const logoutBtn = document.getElementById("logout-btn");
                const adminUserEmail = document.getElementById("admin-user-email");

                // Metrics
                const statTotal = document.getElementById("stat-total-count");
                const statCloud = document.getElementById("stat-cloud-count");

                // Quick Add Elements
                const quickAddForm = document.getElementById("quick-add-form") as HTMLFormElement | null;
                const newUrlInput = document.getElementById("new-tool-url") as HTMLInputElement | null;
                const newNameInput = document.getElementById("new-tool-name") as HTMLInputElement | null;
                const newCatSelect = document.getElementById("new-tool-category") as HTMLSelectElement | null;
                const newDescInput = document.getElementById("new-tool-desc") as HTMLTextAreaElement | null;
                const newTagsInput = document.getElementById("new-tool-tags") as HTMLInputElement | null;
                const newIconInput = document.getElementById("new-tool-icon") as HTMLInputElement | null;
                const newIconPreview = document.getElementById("new-tool-icon-preview") as HTMLImageElement | null;
                const newIconFileInput = document.getElementById("new-tool-icon-file") as HTMLInputElement | null;
                const scrapeBtn = document.getElementById("scrape-btn");
                const scrapeBtnText = document.getElementById("scrape-btn-text");
                const translateAddBtn = document.getElementById("translate-add-desc-btn");
                const translateAddBtnText = document.getElementById("translate-add-btn-text");

                // Table elements
                const tableBody = document.getElementById("tools-table-body");
                const tableSearchInput = document.getElementById("table-search-input") as HTMLInputElement | null;
                const tableFilterCat = document.getElementById("table-filter-category") as HTMLSelectElement | null;
                const saveOrderBtn = document.getElementById("save-order-btn");
                const saveOrderText = document.getElementById("save-order-text");
                const syncIconsBtn = document.getElementById("sync-icons-btn") as HTMLButtonElement | null;
                const syncIconsBtnText = document.getElementById("sync-icons-btn-text");

                // Edit modal
                const editModal = document.getElementById("edit-modal");
                const editForm = document.getElementById("edit-form") as HTMLFormElement | null;
                const closeEditBtn = document.getElementById("close-edit-modal-btn");
                const cancelEditBtn = document.getElementById("cancel-edit-btn");
                const editIdInput = document.getElementById("edit-tool-id") as HTMLInputElement | null;
                const editNameInput = document.getElementById("edit-tool-name") as HTMLInputElement | null;
                const editUrlInput = document.getElementById("edit-tool-url") as HTMLInputElement | null;
                const editCatSelect = document.getElementById("edit-tool-category") as HTMLSelectElement | null;
                const editIconInput = document.getElementById("edit-tool-icon") as HTMLInputElement | null;
                const editIconPreview = document.getElementById("edit-tool-icon-preview") as HTMLImageElement | null;
                const editIconFileInput = document.getElementById("edit-tool-icon-file") as HTMLInputElement | null;
                const editUploadIconBtn = document.getElementById("edit-upload-icon-btn") as HTMLButtonElement | null;
                const editDescInput = document.getElementById("edit-tool-desc") as HTMLTextAreaElement | null;
                const editTagsInput = document.getElementById("edit-tool-tags") as HTMLInputElement | null;
                const translateEditBtn = document.getElementById("translate-edit-desc-btn");
                const translateEditBtnText = document.getElementById("translate-edit-btn-text");

                // SQL Guide Modal
                const sqlGuideModal = document.getElementById("sql-guide-modal");
                const openSqlGuideBtn = document.getElementById("open-sql-guide-btn");
                const closeSqlGuideBtn = document.getElementById("close-sql-guide-btn");
                const closeSqlModalBtn2 = document.getElementById("close-sql-modal-btn2");
                const copySqlBtn = document.getElementById("copy-sql-btn");

                const supabaseUrl = dashboard?.getAttribute("data-supabase-url") || "";
                const supabaseKey = dashboard?.getAttribute("data-supabase-key") || "";

                let allTools: ToolItem[] = [];

                const apiFetch = (url: string, options: RequestInit = {}) =>
                    authFetch(supabaseUrl, supabaseKey, url, options);

                function enterDashboard(session: SupabaseSession) {
                    gateScreen?.classList.add("hidden");
                    dashboard?.classList.remove("hidden");
                    dashboard?.classList.add("flex");
                    if (adminUserEmail) adminUserEmail.textContent = session.email || "管理员";
                    scheduleTokenRefresh(supabaseUrl, supabaseKey, session);
                    loadAllTools();
                }

                // Auto-refresh when tab gains focus or user returns to tab after hours (bind once globally)
                if (!(window as unknown as { __adminVisibilityBound?: boolean }).__adminVisibilityBound) {
                    (window as unknown as { __adminVisibilityBound?: boolean }).__adminVisibilityBound = true;
                    document.addEventListener("visibilitychange", async () => {
                        if (document.visibilityState === "visible") {
                            const curSession = getSavedSession();
                            if (curSession && Date.now() >= (curSession.expires_at || 0) - 5 * 60 * 1000) {
                                await refreshSession(supabaseUrl, supabaseKey, curSession);
                            }
                        }
                    });
                }

                // Check existing session on startup
                const existingSession = getSavedSession();
                if (existingSession && (existingSession.access_token || existingSession.refresh_token)) {
                    if (Date.now() >= (existingSession.expires_at || 0) - 60 * 1000 && existingSession.refresh_token) {
                        refreshSession(supabaseUrl, supabaseKey, existingSession).then((refreshed) => {
                            if (refreshed) {
                                enterDashboard(refreshed);
                            } else if (existingSession.access_token) {
                                enterDashboard(existingSession);
                            } else {
                                saveSession(null);
                            }
                        });
                    } else {
                        enterDashboard(existingSession);
                    }
                }

                // Supabase Auth Login
                loginForm?.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    const email = emailInput?.value.trim() || "";
                    const password = passInput?.value || "";

                    if (!email || !password) {
                        showToast("请输入邮箱和密码", "error");
                        return;
                    }

                    if (loginSubmitBtn) {
                        loginSubmitBtn.textContent = "安全鉴权中...";
                        loginSubmitBtn.setAttribute("disabled", "true");
                    }

                    try {
                        const endpoint = `${supabaseUrl.replace(/\/$/, "")}/auth/v1/token?grant_type=password`;
                        const res = await fetch(endpoint, {
                            method: "POST",
                            headers: {
                                apikey: supabaseKey,
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({ email, password })
                        });

                        const data = await res.json();
                        if (res.ok && data.access_token) {
                            const newSession: SupabaseSession = {
                                access_token: data.access_token,
                                refresh_token: data.refresh_token,
                                expires_at: Date.now() + (data.expires_in || 3600) * 1000,
                                email: data.user?.email || email
                            };

                            if (rememberLoginCheck?.checked) {
                                saveSession(newSession);
                            }

                            enterDashboard(newSession);
                            showToast(`🎉 欢迎回来，${newSession.email}！已获取数据库管理权限`, "success");
                        } else {
                            showToast(`登录失败: ${data.error_description || data.msg || data.message || "账号或密码错误"}`, "error");
                        }
                    } catch (err: any) {
                        showToast(`网络连接异常: ${err.message}`, "error");
                    } finally {
                        if (loginSubmitBtn) {
                            loginSubmitBtn.textContent = "安全登录并进入后台";
                            loginSubmitBtn.removeAttribute("disabled");
                        }
                    }
                });

                logoutBtn?.addEventListener("click", () => {
                    saveSession(null);
                    window.location.reload();
                });

                // Load Tools (Preset + Cloud)
                async function loadAllTools() {
                    allTools = [];

                    const presetEl = document.getElementById("preset-tools-data");
                    if (presetEl && presetEl.textContent) {
                        try {
                            const presets = JSON.parse(presetEl.textContent);
                            presets.forEach((p: any) => {
                                allTools.push({ ...p, source: "preset" });
                            });
                        } catch {
                            // Ignore malformed JSON
                        }
                    }

                    let cloudCount = 0;
                    if (supabaseUrl && supabaseKey) {
                        try {
                            const cloudItems = await fetchCloudTools(supabaseUrl, supabaseKey);
                            cloudCount = cloudItems.length;
                            cloudItems.forEach((tool) => {
                                const existingIdx = allTools.findIndex((t) => t.id === tool.id || t.url === tool.url);
                                if (existingIdx >= 0) {
                                    allTools[existingIdx] = tool;
                                } else {
                                    allTools.push(tool);
                                }
                            });
                        } catch (e) {
                            console.warn("Cloud load notice", e);
                        }
                    }

                    if (statTotal) statTotal.textContent = String(allTools.length);
                    if (statCloud) statCloud.textContent = String(cloudCount);

                    renderTable();
                }

                // Render Table Rows
                function renderTable() {
                    if (!tableBody) return;
                    tableBody.innerHTML = "";

                    const search = (tableSearchInput?.value || "").toLowerCase().trim();
                    const category = tableFilterCat?.value || "全部";

                    const filtered = allTools.filter((t) => {
                        const matchCat = category === "全部" || t.category === category;
                        const matchSearch = !search ||
                            t.name.toLowerCase().includes(search) ||
                            t.description.toLowerCase().includes(search) ||
                            (t.tags || []).join(" ").toLowerCase().includes(search);
                        return matchCat && matchSearch;
                    });

                    if (filtered.length === 0) {
                        tableBody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-ink/40 dark:text-gray/50">没有找到匹配的工具</td></tr>`;
                        return;
                    }

                    filtered.forEach((tool) => {
                        const safeId = escapeHtml(tool.id);
                        const safeName = escapeHtml(tool.name);
                        const safeCategory = escapeHtml(tool.category);
                        const safeDesc = escapeHtml(tool.description);
                        const safeUrl = escapeHtml(sanitizeUrl(tool.url));
                        const safeIcon = escapeHtml(sanitizeUrl(tool.icon, "/favicon.svg"));

                        const tr = document.createElement("tr");
                        tr.className = "tool-table-row hover:bg-black/5 dark:hover:bg-white/5 transition-colors group cursor-default border-b border-[var(--glass-border)]/50";
                        tr.setAttribute("draggable", "true");
                        tr.setAttribute("data-id", tool.id);

                        const sourceBadge = tool.source === "cloud"
                            ? `<span class="rounded bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold text-emerald-600">云端实时</span>`
                            : `<span class="rounded bg-black/5 px-2 py-0.5 text-[10px] font-medium text-ink/60 dark:bg-white/10 dark:text-gray">预置默认</span>`;

                        tr.innerHTML = `
                            <td class="py-2.5 px-2 text-center select-none">
                                <div class="flex items-center justify-center gap-1">
                                    <span
                                        class="drag-handle inline-flex items-center justify-center p-1 rounded text-ink/35 hover:text-accent cursor-grab active:cursor-grabbing hover:bg-black/5 dark:hover:bg-white/10 transition"
                                        title="按住上下拖拽调整顺序"
                                    >
                                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M7 2a2 2 0 100 4 2 2 0 000-4zm6 0a2 2 0 100 4 2 2 0 000-4zM7 8a2 2 0 100 4 2 2 0 000-4zm6 0a2 2 0 100 4 2 2 0 000-4zM7 14a2 2 0 100 4 2 2 0 000-4zm6 0a2 2 0 100 4 2 2 0 000-4z" />
                                        </svg>
                                    </span>
                                    <div class="flex flex-col text-[9px] text-ink/40">
                                        <button type="button" class="move-up-btn hover:text-accent hover:font-bold px-0.5 leading-tight" title="上移一位" data-id="${safeId}">▲</button>
                                        <button type="button" class="move-down-btn hover:text-accent hover:font-bold px-0.5 leading-tight" title="下移一位" data-id="${safeId}">▼</button>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 px-3">
                                <div class="flex items-center gap-2.5">
                                    <div class="relative h-8 w-8 shrink-0 rounded-lg border border-[var(--glass-border)] bg-white/70 p-1 dark:bg-black/20 flex items-center justify-center">
                                        <img src="${safeIcon}" alt="" class="h-full w-full object-contain" onerror="this.src='/favicon.svg'" />
                                        ${isCdnIcon(tool.icon) ? `<span class="absolute -top-1 -right-1 flex h-3.5 w-3.5 items-center justify-center rounded-full bg-sky-500 text-[8px] font-bold text-white shadow-sm" title="已托管于 Supabase 极速 CDN">☁</span>` : ''}
                                    </div>
                                    <div class="min-w-0">
                                        <div class="font-bold text-ink dark:text-gray-dark truncate">${safeName}</div>
                                        <a href="${safeUrl}" target="_blank" rel="noreferrer" class="text-[11px] text-accent hover:underline truncate block max-w-xs">${safeUrl}</a>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 px-3">
                                <span class="font-medium text-ink/80 dark:text-gray-dark">${safeCategory}</span>
                            </td>
                            <td class="py-3 px-3 max-w-xs">
                                <p class="text-ink/70 dark:text-gray/80 truncate" title="${safeDesc}">${safeDesc}</p>
                            </td>
                            <td class="py-3 px-3">${sourceBadge}</td>
                            <td class="py-3 px-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <button
                                        type="button"
                                        class="edit-btn p-1.5 rounded-lg text-ink/70 hover:bg-black/5 hover:text-accent dark:text-gray dark:hover:bg-white/10"
                                        title="编辑"
                                        data-id="${safeId}"
                                    >
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>
                                    <button
                                        type="button"
                                        class="delete-btn p-1.5 rounded-lg text-red-500 hover:bg-red-500/10"
                                        title="删除"
                                        data-id="${safeId}"
                                    >
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        `;
                        tableBody.appendChild(tr);
                    });

                    // Attach Drag & Drop reorder handlers
                    let draggedId: string | null = null;
                    const rows = tableBody.querySelectorAll<HTMLTableRowElement>(".tool-table-row");

                    rows.forEach((row) => {
                        row.addEventListener("dragstart", (e) => {
                            draggedId = row.getAttribute("data-id");
                            row.classList.add("opacity-40", "bg-accent/10");
                            if (e.dataTransfer) {
                                e.dataTransfer.effectAllowed = "move";
                                e.dataTransfer.setData("text/plain", draggedId || "");
                            }
                        });

                        row.addEventListener("dragend", () => {
                            row.classList.remove("opacity-40", "bg-accent/10");
                            rows.forEach((r) => {
                                r.classList.remove("border-t-2", "border-b-2", "border-accent");
                            });
                            draggedId = null;
                        });

                        row.addEventListener("dragover", (e) => {
                            e.preventDefault();
                            if (!draggedId || draggedId === row.getAttribute("data-id")) return;
                            if (e.dataTransfer) {
                                e.dataTransfer.dropEffect = "move";
                            }
                            const rect = row.getBoundingClientRect();
                            const isUpper = e.clientY < rect.top + rect.height / 2;
                            if (isUpper) {
                                row.classList.add("border-t-2", "border-accent");
                                row.classList.remove("border-b-2");
                            } else {
                                row.classList.add("border-b-2", "border-accent");
                                row.classList.remove("border-t-2");
                            }
                        });

                        row.addEventListener("dragleave", () => {
                            row.classList.remove("border-t-2", "border-b-2", "border-accent");
                        });

                        row.addEventListener("drop", (e) => {
                            e.preventDefault();
                            row.classList.remove("border-t-2", "border-b-2", "border-accent");
                            const targetId = row.getAttribute("data-id");
                            if (!draggedId || !targetId || draggedId === targetId) return;

                            const rect = row.getBoundingClientRect();
                            const isUpper = e.clientY < rect.top + rect.height / 2;

                            const fromIndex = allTools.findIndex((t) => t.id === draggedId);
                            let toIndex = allTools.findIndex((t) => t.id === targetId);

                            if (fromIndex !== -1 && toIndex !== -1) {
                                const [movedItem] = allTools.splice(fromIndex, 1);
                                toIndex = allTools.findIndex((t) => t.id === targetId);
                                if (isUpper) {
                                    allTools.splice(toIndex, 0, movedItem);
                                } else {
                                    allTools.splice(toIndex + 1, 0, movedItem);
                                }

                                renderTable();
                                saveToolsOrder(allTools);
                            }
                        });
                    });

                    // Quick move up / down buttons
                    tableBody.querySelectorAll<HTMLButtonElement>(".move-up-btn").forEach((btn) => {
                        btn.addEventListener("click", () => {
                            const id = btn.getAttribute("data-id");
                            const idx = allTools.findIndex((t) => t.id === id);
                            if (idx > 0) {
                                const [item] = allTools.splice(idx, 1);
                                allTools.splice(idx - 1, 0, item);
                                renderTable();
                                saveToolsOrder(allTools);
                            }
                        });
                    });

                    tableBody.querySelectorAll<HTMLButtonElement>(".move-down-btn").forEach((btn) => {
                        btn.addEventListener("click", () => {
                            const id = btn.getAttribute("data-id");
                            const idx = allTools.findIndex((t) => t.id === id);
                            if (idx !== -1 && idx < allTools.length - 1) {
                                const [item] = allTools.splice(idx, 1);
                                allTools.splice(idx + 1, 0, item);
                                renderTable();
                                saveToolsOrder(allTools);
                            }
                        });
                    });

                    // Attach edit & delete handlers
                    tableBody.querySelectorAll<HTMLButtonElement>(".edit-btn").forEach((btn) => {
                        btn.addEventListener("click", () => {
                            const id = btn.getAttribute("data-id");
                            const tool = allTools.find((t) => t.id === id);
                            if (tool) openEditModal(tool);
                        });
                    });

                    tableBody.querySelectorAll<HTMLButtonElement>(".delete-btn").forEach((btn) => {
                        btn.addEventListener("click", () => {
                            const id = btn.getAttribute("data-id") || "";
                            const tool = allTools.find((t) => t.id === id);
                            if (tool) handleDeleteTool(tool);
                        });
                    });
                }

                // Save tools order to Supabase (only PATCH rows whose sort_order changed)
                async function saveToolsOrder(toolsList: ToolItem[]) {
                    const changedItems: Array<{ tool: ToolItem; nextOrder: number }> = [];
                    toolsList.forEach((tool, idx) => {
                        if (tool.sort_order !== idx) {
                            changedItems.push({ tool, nextOrder: idx });
                        }
                    });

                    if (changedItems.length === 0) return;

                    if (saveOrderBtn && saveOrderText) {
                        saveOrderBtn.classList.remove("hidden");
                        saveOrderText.textContent = "保存中...";
                    }

                    try {
                        const responses = await Promise.all(
                            changedItems.map(({ tool, nextOrder }) =>
                                apiFetch(`${supabaseUrl.replace(/\/$/, "")}/rest/v1/ai_tools?id=eq.${encodeURIComponent(tool.id)}`, {
                                    method: "PATCH",
                                    headers: {
                                        "Content-Type": "application/json",
                                        Prefer: "return=minimal"
                                    },
                                    body: JSON.stringify({ sort_order: nextOrder })
                                })
                            )
                        );

                        const hasMissingColumn = responses.some((r) => r.status === 400);
                        const allOk = responses.every((r) => r.ok);

                        if (allOk) {
                            changedItems.forEach(({ tool, nextOrder }) => {
                                tool.sort_order = nextOrder;
                            });
                            showToast("🎉 排序已自动同步保存至云端数据库！", "success");
                            if (saveOrderText) saveOrderText.textContent = "已保存";
                            setTimeout(() => {
                                if (saveOrderBtn) saveOrderBtn.classList.add("hidden");
                                if (saveOrderText) saveOrderText.textContent = "保存排序";
                            }, 2000);
                        } else if (hasMissingColumn) {
                            showToast("⚠️ 数据库缺少 sort_order 字段，请在 Supabase 执行 SQL", "error");
                            openSqlGuideBtn?.click();
                            if (saveOrderText) saveOrderText.textContent = "字段未添加";
                        } else {
                            showToast("部分排序保存失败，请检查数据库权限", "error");
                            if (saveOrderText) saveOrderText.textContent = "重试保存";
                        }
                    } catch (err: any) {
                        if (err.message === "UNAUTHORIZED") {
                            showToast("管理员登录已失效，请重新登录", "error");
                            saveSession(null);
                            window.location.reload();
                            return;
                        }
                        showToast(`网络保存失败: ${err.message}`, "error");
                        if (saveOrderText) saveOrderText.textContent = "重试保存";
                    }
                }

                saveOrderBtn?.addEventListener("click", () => saveToolsOrder(allTools));

                // Batch Sync Icons to Supabase Storage
                syncIconsBtn?.addEventListener("click", async () => {
                    const pendingTools = allTools.filter(
                        (t) => t.icon && t.icon.startsWith("http") && !isCdnIcon(t.icon)
                    );

                    if (pendingTools.length === 0) {
                        showToast("🎉 所有工具的图标均已保存在 Supabase Storage CDN，无需迁移！", "success");
                        return;
                    }

                    if (!confirm(`检测到有 ${pendingTools.length} 款工具的图标仍为第三方外链。\n\n点击确定将自动将图标下载并上传至 Supabase Storage，并将访问链接更新为全球高速 CDN 链接。\n\n是否立即开始一键转存？`)) {
                        return;
                    }

                    if (syncIconsBtnText) syncIconsBtnText.textContent = `准备转存 (0/${pendingTools.length})...`;
                    syncIconsBtn?.setAttribute("disabled", "true");

                    let successCount = 0;
                    let failCount = 0;

                    for (let i = 0; i < pendingTools.length; i++) {
                        const tool = pendingTools[i];
                        if (syncIconsBtnText) syncIconsBtnText.textContent = `转存中 (${i + 1}/${pendingTools.length}): ${tool.name}...`;

                        try {
                            const publicCdnUrl = await transferIconToSupabase(supabaseUrl, supabaseKey, tool.icon, tool.id);
                            const patchRes = await apiFetch(
                                `${supabaseUrl.replace(/\/$/, "")}/rest/v1/ai_tools?id=eq.${encodeURIComponent(tool.id)}`,
                                {
                                    method: "PATCH",
                                    headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ icon: publicCdnUrl })
                                }
                            );

                            if (patchRes.ok) {
                                tool.icon = publicCdnUrl;
                                successCount++;
                            } else {
                                failCount++;
                            }
                        } catch (err: any) {
                            console.error(`Failed to transfer icon for ${tool.name}:`, err);
                            if (err.message === "BUCKET_NOT_FOUND") {
                                showToast("⚠️ 存储桶 tool-icons 尚未创建，请先点击右上角「RLS 安全策略」执行 SQL！", "error");
                                openSqlGuideBtn?.click();
                                break;
                            }
                            failCount++;
                        }
                    }

                    if (syncIconsBtnText) syncIconsBtnText.textContent = "☁️ 转存图标至 Supabase";
                    syncIconsBtn?.removeAttribute("disabled");

                    if (successCount > 0) {
                        showToast(`🎉 成功将 ${successCount} 个图标转存至 Supabase CDN！${failCount > 0 ? `(${failCount} 个失败)` : ""}`, "success");
                        renderTable();
                    } else if (failCount > 0) {
                        showToast(`转存失败，请检查网络或确认存储桶 tool-icons 是否已创建`, "error");
                    }
                });

                // Local icon file upload for Quick Add
                newIconFileInput?.addEventListener("change", async (e) => {
                    const file = (e.target as HTMLInputElement).files?.[0];
                    if (!file) return;

                    showToast("正在上传本地图标至 Supabase 存储桶...", "info");
                    const tempSlug = "icon-" + Date.now().toString(36);
                    try {
                        const cdnUrl = await uploadBlobToSupabaseStorage(supabaseUrl, supabaseKey, file, tempSlug);
                        if (newIconPreview) newIconPreview.src = cdnUrl;
                        if (newIconInput) newIconInput.value = cdnUrl;
                        showToast("✅ 本地图标已成功上传至 Supabase Storage CDN！", "success");
                    } catch (err: any) {
                        if (err.message === "BUCKET_NOT_FOUND") {
                            showToast("⚠️ 存储桶 tool-icons 尚未创建，请先在 Supabase 执行 SQL", "error");
                            openSqlGuideBtn?.click();
                        } else {
                            showToast(`图标上传失败: ${err.message}`, "error");
                        }
                    }
                });

                // Local icon file upload for Edit Modal
                editIconFileInput?.addEventListener("change", async (e) => {
                    const file = (e.target as HTMLInputElement).files?.[0];
                    const id = editIdInput?.value || "icon";
                    if (!file) return;

                    showToast("正在上传本地图标至 Supabase 存储桶...", "info");
                    try {
                        const cdnUrl = await uploadBlobToSupabaseStorage(supabaseUrl, supabaseKey, file, id);
                        if (editIconInput) editIconInput.value = cdnUrl;
                        if (editIconPreview) editIconPreview.src = cdnUrl;
                        showToast("✅ 图标已成功上传至 Supabase Storage CDN！保存后生效", "success");
                    } catch (err: any) {
                        if (err.message === "BUCKET_NOT_FOUND") {
                            showToast("⚠️ 存储桶 tool-icons 尚未创建，请先在 Supabase 执行 SQL", "error");
                            openSqlGuideBtn?.click();
                        } else {
                            showToast(`图标上传失败: ${err.message}`, "error");
                        }
                    }
                });

                // Manual transfer icon to Supabase in Edit Modal
                editUploadIconBtn?.addEventListener("click", async () => {
                    const currentUrl = editIconInput?.value.trim() || "";
                    const id = editIdInput?.value || "icon";
                    if (!currentUrl || !currentUrl.startsWith("http")) {
                        showToast("请输入有效的网络图标 URL", "error");
                        return;
                    }
                    if (isCdnIcon(currentUrl)) {
                        showToast("该图标已托管在 Supabase CDN 中", "info");
                        return;
                    }

                    const prevText = editUploadIconBtn.textContent;
                    editUploadIconBtn.textContent = "转存中...";
                    try {
                        const cdnUrl = await transferIconToSupabase(supabaseUrl, supabaseKey, currentUrl, id);
                        if (editIconInput) editIconInput.value = cdnUrl;
                        if (editIconPreview) editIconPreview.src = cdnUrl;
                        showToast("✅ 图标已成功转存至 Supabase CDN！保存后生效", "success");
                    } catch (err: any) {
                        if (err.message === "BUCKET_NOT_FOUND") {
                            showToast("⚠️ 存储桶 tool-icons 尚未创建，请先执行 SQL", "error");
                            openSqlGuideBtn?.click();
                        } else {
                            showToast(`转存失败: ${err.message}`, "error");
                        }
                    } finally {
                        editUploadIconBtn.textContent = prevText;
                    }
                });

                editIconInput?.addEventListener("input", () => {
                    if (editIconPreview) editIconPreview.src = editIconInput.value.trim() || "/favicon.svg";
                });

                tableSearchInput?.addEventListener("input", renderTable);
                tableFilterCat?.addEventListener("change", renderTable);

                // Auto Scrape URL
                async function handleScrape() {
                    const rawUrl = newUrlInput?.value.trim() || "";
                    if (!rawUrl) {
                        showToast("请先输入官方网址", "error");
                        newUrlInput?.focus();
                        return;
                    }

                    let validUrl = rawUrl;
                    if (!/^https?:\/\//i.test(validUrl)) {
                        validUrl = "https://" + validUrl;
                        if (newUrlInput) newUrlInput.value = validUrl;
                    }

                    let parsed: URL;
                    try {
                        parsed = new URL(validUrl);
                    } catch {
                        showToast("网址格式有误", "error");
                        return;
                    }

                    if (scrapeBtnText) scrapeBtnText.textContent = "抓取中...";
                    scrapeBtn?.setAttribute("disabled", "true");

                    const domain = parsed.hostname.replace(/^www\./, "");
                    const iconUrl = `https://icons.duckduckgo.com/ip3/${domain}.ico`;
                    if (newIconPreview) newIconPreview.src = iconUrl;
                    if (newIconInput) newIconInput.value = iconUrl;

                    let titleGuess = domain.split(".")[0];
                    titleGuess = titleGuess.charAt(0).toUpperCase() + titleGuess.slice(1);
                    if (newNameInput && !newNameInput.value) {
                        newNameInput.value = titleGuess;
                    }

                    try {
                        const res = await fetch(`https://api.microlink.io?url=${encodeURIComponent(validUrl)}`);
                        if (res.ok) {
                            const json = await res.json();
                            const data = json.data;
                            if (data.title && newNameInput) {
                                newNameInput.value = cleanToolTitle(data.title, domain) || titleGuess;
                            }
                            if (data.description && newDescInput) {
                                let desc = data.description.trim();
                                if (desc && !containsChinese(desc)) {
                                    if (scrapeBtnText) scrapeBtnText.textContent = "翻译为中文中...";
                                    try {
                                        const translated = await translateToChinese(desc);
                                        if (translated) desc = translated;
                                    } catch (e) {
                                        console.warn("Auto translate notice:", e);
                                    }
                                }
                                newDescInput.value = desc;
                            }
                            if (data.logo?.url) {
                                if (newIconPreview) newIconPreview.src = data.logo.url;
                                if (newIconInput) newIconInput.value = data.logo.url;
                            }

                            // Smart Category
                            const text = `${data.title || ""} ${data.description || ""}`.toLowerCase();
                            if (newCatSelect) {
                                if (/code|coding|dev|program|vscode|开发|编程|前端|后端|代码/.test(text)) {
                                    newCatSelect.value = "开发编程";
                                } else if (/image|photo|draw|art|design|图片|图像|绘图|设计/.test(text)) {
                                    newCatSelect.value = "图像设计";
                                } else if (/chat|gpt|conversation|write|translate|对话|写作|文本/.test(text)) {
                                    newCatSelect.value = "写作对话";
                                } else if (/music|audio|voice|video|音乐|音频|视频/.test(text)) {
                                    newCatSelect.value = "音频视频";
                                } else if (/search|research|paper|搜索|研究|学术/.test(text)) {
                                    newCatSelect.value = "学习研究";
                                } else if (/notion|note|productivity|office|效率|办公|笔记/.test(text)) {
                                    newCatSelect.value = "效率办公";
                                }
                            }
                            showToast("✅ 已成功提取并生成中文简介与图标", "success");
                        }
                    } catch {
                        showToast("抓取部分超时，已使用域名图标兜底", "info");
                    } finally {
                        if (scrapeBtnText) scrapeBtnText.textContent = "自动抓取信息";
                        scrapeBtn?.removeAttribute("disabled");
                    }
                }

                // Manual Description Translation
                async function handleManualTranslate(textarea: HTMLTextAreaElement | null, btnText: HTMLElement | null) {
                    if (!textarea || !textarea.value.trim()) {
                        showToast("请先输入或粘贴简介内容", "error");
                        return;
                    }
                    const original = textarea.value.trim();
                    if (containsChinese(original)) {
                        showToast("当前内容已包含中文，无需翻译", "info");
                        return;
                    }
                    const prevText = btnText ? btnText.textContent : "一键翻译为中文";
                    if (btnText) btnText.textContent = "翻译中...";
                    try {
                        const zh = await translateToChinese(original);
                        if (zh && zh !== original) {
                            textarea.value = zh;
                            showToast("✅ 已成功翻译为地道中文！", "success");
                        } else {
                            showToast("未检测到不同语言，保持原样", "info");
                        }
                    } catch (e: any) {
                        showToast(`翻译失败: ${e.message}`, "error");
                    } finally {
                        if (btnText) btnText.textContent = prevText;
                    }
                }

                translateAddBtn?.addEventListener("click", () => handleManualTranslate(newDescInput, translateAddBtnText));
                translateEditBtn?.addEventListener("click", () => handleManualTranslate(editDescInput, translateEditBtnText));

                scrapeBtn?.addEventListener("click", handleScrape);
                newUrlInput?.addEventListener("blur", () => {
                    if (newUrlInput.value && (!newNameInput?.value || !newDescInput?.value)) {
                        handleScrape();
                    }
                });

                // Submit Quick Add Tool with Admin Bearer Token
                quickAddForm?.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    const url = newUrlInput?.value.trim() || "";
                    const name = newNameInput?.value.trim() || "";
                    const category = newCatSelect?.value || "其他实用";
                    const desc = newDescInput?.value.trim() || "";
                    const icon = newIconInput?.value || "/favicon.svg";
                    const tagsStr = newTagsInput?.value.trim() || "";
                    const tags = tagsStr ? tagsStr.split(/[,，]/).map((t) => t.trim()).filter(Boolean) : [category];

                    if (!url || !name || !desc) {
                        showToast("请完整填写网址、名称与简介", "error");
                        return;
                    }

                    let parsedUrl: URL;
                    try {
                        parsedUrl = new URL(url);
                    } catch {
                        showToast("工具网址格式无效，请以 http:// 或 https:// 开头", "error");
                        newUrlInput?.focus();
                        return;
                    }

                    const submitBtn = document.getElementById("submit-btn");
                    const submitText = document.getElementById("submit-btn-text");
                    if (submitText) submitText.textContent = "发布中...";
                    submitBtn?.setAttribute("disabled", "true");

                    try {
                        const slug = parsedUrl.hostname.replace(/^www\./, "").split(".")[0].toLowerCase().replace(/[^a-z0-9_-]/g, "") + "-" + Date.now().toString(36);

                        let finalIcon = icon;
                        if (finalIcon.startsWith("http") && !isCdnIcon(finalIcon)) {
                            if (submitText) submitText.textContent = "转存图标中...";
                            try {
                                finalIcon = await transferIconToSupabase(supabaseUrl, supabaseKey, finalIcon, slug);
                            } catch (err: any) {
                                console.warn("Icon upload notice:", err);
                                if (err.message === "BUCKET_NOT_FOUND") {
                                    showToast("提示：存储桶 tool-icons 尚未创建，图标暂以外链保存。请在右上角复制 SQL 执行建桶", "info");
                                }
                            }
                        }

                        if (submitText) submitText.textContent = "发布中...";

                        const endpoint = `${supabaseUrl.replace(/\/$/, "")}/rest/v1/ai_tools`;
                        const payload: any = {
                            id: slug,
                            name,
                            url,
                            icon: finalIcon,
                            category,
                            description: desc,
                            tags,
                            sort_order: allTools.length
                        };

                        let res = await apiFetch(endpoint, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                Prefer: "return=representation"
                            },
                            body: JSON.stringify(payload)
                        });

                        // Fallback if sort_order column not yet added
                        if (!res.ok && res.status === 400) {
                            delete payload.sort_order;
                            res = await apiFetch(endpoint, {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json",
                                    Prefer: "return=representation"
                                },
                                body: JSON.stringify(payload)
                            });
                        }

                        if (res.ok) {
                            const isCdn = isCdnIcon(finalIcon);
                            showToast(isCdn ? `🎉 成功添加「${name}」！图标已自动托管至 Supabase CDN` : `🎉 成功添加「${name}」！全网访客已可实时浏览`, "success");
                            quickAddForm.reset();
                            if (newIconPreview) newIconPreview.src = "/favicon.svg";
                            if (newIconInput) newIconInput.value = "/favicon.svg";
                            loadAllTools();
                        } else {
                            if (res.status === 401 || res.status === 403) {
                                showToast("权限校验未通过：请确认已登录管理员或执行了 RLS 安全策略", "error");
                            } else {
                                const err = await res.json().catch(() => ({}));
                                showToast(`发布失败: ${err.message || res.statusText}`, "error");
                            }
                        }
                    } catch (err: any) {
                        if (err.message === "UNAUTHORIZED") {
                            showToast("管理员登录已失效，请重新登录", "error");
                            saveSession(null);
                            window.location.reload();
                            return;
                        }
                        showToast(`网络请求失败: ${err.message}`, "error");
                    } finally {
                        if (submitText) submitText.textContent = "立即发布至云端";
                        submitBtn?.removeAttribute("disabled");
                    }
                });

                // Edit Tool Flow with Admin Bearer Token
                function openEditModal(tool: ToolItem) {
                    if (editIdInput) editIdInput.value = tool.id;
                    if (editNameInput) editNameInput.value = tool.name;
                    if (editUrlInput) editUrlInput.value = tool.url;
                    if (editCatSelect) editCatSelect.value = tool.category;
                    if (editIconInput) editIconInput.value = tool.icon;
                    if (editIconPreview) editIconPreview.src = tool.icon || "/favicon.svg";
                    if (editDescInput) editDescInput.value = tool.description;
                    if (editTagsInput) editTagsInput.value = (tool.tags || []).join(", ");
                    editModal?.classList.remove("hidden");
                }

                closeEditBtn?.addEventListener("click", () => editModal?.classList.add("hidden"));
                cancelEditBtn?.addEventListener("click", () => editModal?.classList.add("hidden"));

                editForm?.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    const id = editIdInput?.value || "";
                    const name = editNameInput?.value.trim() || "";
                    const url = editUrlInput?.value.trim() || "";
                    const category = editCatSelect?.value || "其他实用";
                    const icon = editIconInput?.value || "/favicon.svg";
                    const desc = editDescInput?.value.trim() || "";
                    const tagsStr = editTagsInput?.value.trim() || "";
                    const tags = tagsStr ? tagsStr.split(/[,，]/).map((t) => t.trim()).filter(Boolean) : [category];

                    let finalIcon = icon;
                    if (finalIcon.startsWith("http") && !isCdnIcon(finalIcon)) {
                        try {
                            finalIcon = await transferIconToSupabase(supabaseUrl, supabaseKey, finalIcon, id);
                        } catch (e: any) {
                            console.warn("Edit icon transfer notice:", e);
                        }
                    }

                    try {
                        const endpoint = `${supabaseUrl.replace(/\/$/, "")}/rest/v1/ai_tools?id=eq.${encodeURIComponent(id)}`;
                        const res = await apiFetch(endpoint, {
                            method: "PATCH",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                name,
                                url,
                                icon: finalIcon,
                                category,
                                description: desc,
                                tags
                            })
                        });

                        if (res.ok) {
                            showToast(`✅ 已成功更新「${name}」！`, "success");
                            editModal?.classList.add("hidden");
                            loadAllTools();
                        } else {
                            showToast("更新失败，请确认是否具备修改权限", "error");
                        }
                    } catch (err: any) {
                        if (err.message === "UNAUTHORIZED") {
                            showToast("登录凭证已失效，请重新登录", "error");
                            saveSession(null);
                            window.location.reload();
                            return;
                        }
                        showToast(`保存出错: ${err.message}`, "error");
                    }
                });

                // Delete Tool Flow with Admin Bearer Token (also removes orphaned Storage icon)
                async function handleDeleteTool(tool: ToolItem) {
                    if (!confirm(`确定要从数据库中彻底下架「${tool.name}」吗？`)) return;

                    try {
                        const endpoint = `${supabaseUrl.replace(/\/$/, "")}/rest/v1/ai_tools?id=eq.${encodeURIComponent(tool.id)}`;
                        const res = await apiFetch(endpoint, {
                            method: "DELETE"
                        });

                        if (res.ok) {
                            await deleteIconFromSupabaseStorage(supabaseUrl, supabaseKey, tool.icon);
                            showToast(`🗑️ 已成功下架「${tool.name}」`, "success");
                            loadAllTools();
                        } else {
                            showToast("删除失败，请检查数据库权限", "error");
                        }
                    } catch (err: any) {
                        if (err.message === "UNAUTHORIZED") {
                            showToast("登录凭证已失效，请重新登录", "error");
                            saveSession(null);
                            window.location.reload();
                            return;
                        }
                        showToast(`操作失败: ${err.message}`, "error");
                    }
                }

                // RLS SQL Guide Modal
                openSqlGuideBtn?.addEventListener("click", () => sqlGuideModal?.classList.remove("hidden"));
                closeSqlGuideBtn?.addEventListener("click", () => sqlGuideModal?.classList.add("hidden"));
                closeSqlModalBtn2?.addEventListener("click", () => sqlGuideModal?.classList.add("hidden"));

                copySqlBtn?.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(RLS_SQL_CODE);
                        showToast("安全 RLS 脚本已复制！请前往 Supabase 执行", "success");
                    } catch {
                        showToast("请手动在项目根目录复制 src/data/supabase-schema.sql", "error");
                    }
                });
            }

            document.addEventListener("astro:page-load", initAdmin);
            document.addEventListener("astro:before-swap", clearTokenRefreshTimer);
        </script>
    </body>
</html>
